<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0e17">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" href="icon-192.png" type="image/png">
  <link rel="apple-touch-icon" href="icon-192.png">
  <title>Binance Filter</title>
  <style>
    :root {
      --bg: #0d1117;
      --card: #161b22;
      --card2: #1c2128;
      --border: #30363d;
      --green: #00c087;
      --green-bg: rgba(0,192,135,0.15);
      --red: #ff4d4d;
      --red-bg: rgba(255,77,77,0.15);
      --yellow: #f0b90b;
      --yellow-bg: rgba(240,185,11,0.1);
      --purple: #b07fff;
      --purple-bg: rgba(176,127,255,0.15);
      --text: #e6edf3;
      --text-muted: #8b949e;
      --radius: 10px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #000610;
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      padding: 10px;
    }

    #app-shell {
      width: 100%;
      max-width: 820px;
      background: #000a1f;
      border: 1.5px solid #1a2744;
      border-radius: 14px;
      overflow: hidden;
      box-shadow: 0 4px 40px rgba(0,0,0,0.6);
      display: flex;
      flex-direction: column;
      height: calc(100vh - 20px);
    }

    header {
      background: var(--card);
      border-bottom: 1px solid var(--border);
      padding: 8px 14px;
      display: flex;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 200;
      gap: 6px;
      flex-wrap: wrap;
    }
    #scroll-section {
      flex: 1;
      overflow-y: auto;
      min-height: 0;
      scrollbar-width: none;
    }
    #scroll-section::-webkit-scrollbar { display: none; }
    #header-right { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    #header-action-btns, #tf-action-btns { display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    #header-action-btns button, #tf-action-btns button { padding:4px 10px; font-size:0.75rem; border-radius:6px; cursor:pointer; border:1px solid #2a3a50; background:#0f1923; color:#cdd9e5; font-weight:600; transition:background 0.2s; }
    #scan-btn { background:#f0c040 !important; color:#000 !important; border-color:#f0c040 !important; }
    #scan-btn:hover { background:#e0b030 !important; }
    #scan-btn:disabled { background:#c0a030 !important; color:#333 !important; border-color:#c0a030 !important; opacity: 0.7; }
    #clear-btn:hover, #trend-lock-btn:hover { background:#1e2d40; }
    #sort-select { padding:3px 6px; font-size:0.75rem; border-radius:6px; border:1px solid #2a3a50; background:#0f1923; color:#cdd9e5; cursor:pointer; }
    .auto-scan-wrap { font-size:0.75rem; color:#cdd9e5; display:flex; align-items:center; gap:4px; }
    #countdown-text { font-size:0.7rem; color:#888; min-width:18px; }

    #detail-panel {
      background: #050d1a;
      border: 1.5px solid #1e3a5f;
      border-radius: 8px;
      padding: 12px 14px;
      margin: 0 10px 10px;
      font-size: 0.8rem;
      color: #9ca3af;
      line-height: 1.6;
      cursor: pointer;
      user-select: none;
      position: relative;
    }

    header h1 {
      font-size: 1.05rem;
      font-weight: 700;
      color: var(--yellow);
      letter-spacing: 0.5px;
    }

    #conn-indicator {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 0.78rem;
      color: var(--text-muted);
      white-space: nowrap;
    }

    #conn-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #555;
      box-shadow: 0 0 6px #555;
      transition: background 0.5s, box-shadow 0.5s;
      flex-shrink: 0;
    }

    #conn-dot.online  { background: var(--green); box-shadow: 0 0 8px var(--green); }
    #conn-dot.offline { background: var(--red);   box-shadow: 0 0 8px var(--red); }

    .section {
      padding: 10px;
    }

    .panel {
      background: #000a1f;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 8px 10px;
    }

    #tf-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      align-items: center;
    }

    #sort-select {
      background: var(--card2);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      padding: 5px 6px;
      font-size: 0.68rem;
      cursor: pointer;
    }

    #btc-status {
      display: flex;
      margin-top: 6px;
      padding: 5px 8px;
      border-top: 1px solid var(--border);
      font-size: 0.68rem;
      gap: 5px;
      align-items: center;
      flex-wrap: wrap;
    }

    .btc-label {
      font-weight: 700;
      color: var(--yellow);
      margin-right: 4px;
    }

    .btc-price {
      font-size: 0.75rem;
      font-weight: 700;
      color: #f0b90b;
      background: #1a1f35;
      border-radius: 4px;
      padding: 1px 6px;
      margin-right: 4px;
    }

    .btc-change {
      font-weight: 600;
      padding: 1px 5px;
      border-radius: 3px;
      margin-right: 4px;
    }

    .btc-change.pos { background: var(--green-bg); color: var(--green); }
    .btc-change.neg { background: var(--red-bg); color: var(--red); }

    .btc-tf {
      font-size: 0.62rem;
      font-weight: 600;
      padding: 2px 5px;
      border-radius: 3px;
    }

    .btc-tf.green { background: var(--green-bg); color: var(--green); }
    .btc-tf.red   { background: var(--red-bg);   color: var(--red); }
    .btc-tf.gray  { background: rgba(255,255,255,0.05); color: var(--text-muted); }

    .tf-btn {
      padding: 5px 7px;
      border-radius: 6px;
      border: 2px solid var(--border);
      background: var(--card2);
      color: var(--text-muted);
      font-size: 0.68rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      user-select: none;
      min-width: 38px;
      text-align: center;
    }

    .tf-btn:hover { border-color: #50575f; color: var(--text); }
    .tf-btn.green  { border-color: var(--green); background: var(--green-bg); color: var(--green); }
    .tf-btn.red    { border-color: var(--red);   background: var(--red-bg);   color: var(--red); }

    #controls {
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    #scan-btn {
      background: var(--yellow);
      color: #000;
      border: none;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 0.68rem;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.2s;
      min-width: 52px;
      position: relative;
      overflow: hidden;
    }

    #scan-btn::before {
      content: '';
      position: absolute;
      top: 0; left: 0; bottom: 0;
      width: 100%;
      background: rgba(0,192,135,0.80);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.2s linear;
      z-index: 0;
    }
    #scan-btn.scanning { color: #fff; }

    #scan-btn.scanning::before {
      transform: scaleX(var(--scan-progress, 0));
    }

    #scan-btn:hover { opacity: 0.85; }
    #scan-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    #clear-btn {
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 0.72rem;
      cursor: pointer;
      transition: all 0.15s;
      min-width: 52px;
      font-weight: 600;
    }

    #clear-btn:hover { border-color: var(--red); color: var(--red); }

    #trend-lock-btn {
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 0.72rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
      min-width: 52px;
    }

    #trend-lock-btn:hover { border-color: var(--purple); color: var(--purple); }

    @keyframes trendPulse {
      0%, 100% { border-width: 1px; border-color: var(--border); box-shadow: 0 0 0 rgba(139,92,246,0); }
      50% { border-width: 3px; border-color: var(--purple); box-shadow: 0 0 12px rgba(139,92,246,0.6); }
    }
    #trend-lock-btn.pulse {
      animation: trendPulse 1.2s ease-in-out infinite;
      color: var(--purple);
    }

    header div#header-action-btns button#candle-btn {
      display: inline-block !important;
      padding: 4px 10px !important;
      font-size: 0.75rem !important;
      border-radius: 6px !important;
      cursor: pointer !important;
      border: 1px solid #2a3a50 !important;
      background: #0f1923 !important;
      color: #cdd9e5 !important;
      font-weight: 600 !important;
      min-width: 38px !important;
      transition: all 0.2s !important;
    }
    header div#header-action-btns button#candle-btn:hover { border-color: #f0c040 !important; color: #f0c040 !important; }
    header div#header-action-btns button#candle-btn.active { background: rgba(240,192,64,0.20) !important; border-color: #f0c040 !important; color: #f0c040 !important; font-weight: 700 !important; }

    #trend-lock-btn.active {
      background: var(--green-bg);
      border-color: var(--green);
      color: var(--green);
    }

    #trend-lock-badge {
      display: none;
      font-size: 0.72rem;
      color: var(--purple);
      background: var(--purple-bg);
      border: 1px solid rgba(176,127,255,0.35);
      border-radius: 5px;
      padding: 3px 9px;
      white-space: nowrap;
    }

    #trend-lock-badge.visible { display: inline-block; }

    .auto-scan-wrap {
      display: flex;
      align-items: center;
      gap: 7px;
      color: var(--text-muted);
      font-size: 0.82rem;
      cursor: pointer;
    }

    .auto-scan-wrap input { cursor: pointer; accent-color: var(--yellow); }

    #last-updated {
      color: var(--text-muted);
      font-size: 0.76rem;
      margin-left: auto;
    }

    #countdown-text {
      color: var(--yellow);
      font-size: 0.76rem;
    }

    #progress-wrap { margin-top: 12px; display: none; }
    #progress-wrap.visible { display: block; }

    #progress-bar-bg { background: var(--card2); border-radius: 4px; height: 5px; overflow: hidden; }
    #progress-bar { background: var(--yellow); height: 100%; width: 0%; border-radius: 4px; transition: width 0.15s; }
    #progress-text { font-size: 0.72rem; color: var(--text-muted); margin-top: 5px; }

    #error-box {
      background: var(--red-bg);
      border: 1px solid var(--red);
      border-radius: 8px;
      padding: 10px 14px;
      color: var(--red);
      font-size: 0.82rem;
      margin-top: 10px;
      display: none;
    }

    #error-box.visible { display: block; }



    .alarm-tag {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 0.75rem;
      font-weight: 600;
      border: 1px solid;
    }

    .alarm-tag.green { border-color: var(--green); color: var(--green); background: var(--green-bg); }
    .alarm-tag.red   { border-color: var(--red);   color: var(--red);   background: var(--red-bg); }

    .alarm-tag.triggered {
      opacity: 0.5;
      text-decoration: line-through;
    }

    .alarm-del {
      background: none;
      border: none;
      color: inherit;
      cursor: pointer;
      font-size: 0.9rem;
      padding: 0;
      line-height: 1;
      opacity: 0.7;
    }

    .alarm-del:hover { opacity: 1; }

    /* Results */
    #results-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 8px;
    }

    #results-count { font-size: 0.88rem; color: var(--text-muted); }
    #results-count span { color: var(--yellow); font-weight: 700; }

    #results-grid {
      margin-top: 10px;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(135px, 1fr));
      gap: 7px;
    }

    @media (max-width: 480px) {
      #results-grid { grid-template-columns: 1fr 1fr; gap: 5px; }
    }

    .coin-card {
      background: var(--card2);
      border: 1px solid var(--border);
      border-radius: 8px;
      padding: 8px 10px;
      transition: border-color 0.15s, box-shadow 0.3s;
      position: relative;
    }

    .coin-card:hover { border-color: var(--yellow); }
    .coin-card.selected { 
      border-color: var(--yellow) !important; 
      border-width: 2px !important;
      box-shadow: 0 0 8px rgba(240,185,11,0.3) !important;
    }
    .coin-card.pullback { border-left: 2px solid rgba(255,70,70,0.4); }
    .coin-card.bounce   { border-left: 2px solid rgba(0,220,120,0.4); }


    /* POPUP */
    .pop-title { font-size: 0.95rem; font-weight: 700; color: #f0c040; margin-bottom: 10px; }
    .pop-row { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px solid #1e2d40; }
    .pop-row:last-of-type { border-bottom: none; }
    .pop-label { color: #6b7280; }
    .pop-val { font-weight: 600; }
    .pop-comment { margin-top: 10px; padding: 8px 10px; border-radius: 8px; font-size: 0.74rem; line-height: 1.5; }
    .pop-comment.bull { background: #052e16; color: #6ee7b7; border-left: 3px solid #00ff88; }
    .pop-comment.bear { background: #2d0a14; color: #fca5a5; border-left: 3px solid #ff2266; }
    .pop-comment.neutral { background: #1a2235; color: #9ca3af; border-left: 3px solid #374151; }

    .coin-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 4px;
      gap: 4px;
    }

    .coin-sym {
      font-weight: 700;
      font-size: 0.62rem;
      color: var(--yellow);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 110px;
      line-height: 1.2;
      cursor: pointer;
      padding: 2px 6px;
      border: 1px solid transparent;
      border-radius: 4px;
      transition: all 0.15s;
    }
    .card-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 4px;
      font-size: 0.62rem;
      gap: 6px;
    }
    .row-label {
      color: #888;
      white-space: nowrap;
    }
    .row-right {
      display: flex;
      gap: 4px;
      align-items: center;
    }
    .btn-detail {
      background: #111827;
      border: 1px solid #2a3f5f;
      border-radius: 4px;
      color: #60a5fa;
      font-size: 0.6rem;
      font-weight: 600;
      padding: 3px 8px;
      cursor: pointer;
      transition: all 0.15s;
      margin-left: auto;
    }
    .btn-detail-sm {
      background: #1a1f35;
      border: none;
      border-radius: 4px;
      color: #4fc3f7;
      font-size: 0.58rem;
      font-weight: 600;
      padding: 2px 8px;
      cursor: pointer;
      flex-shrink: 0;
      line-height: 1.3;
      min-width: 54px;
      text-align: center;
    }
    .btn-detail-sm:hover {
      background: #1e3a5f;
      color: #fff;
    }
    .btn-detail:hover {
      background: #1e3a5f;
      border-color: #60a5fa;
      color: #fff;
    }

    /* Son 3 mum noktalari */
    .candle-wrap {
      display: inline-flex;
      align-items: center;
      gap: 3px;
    }
    .candle-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 2px;
    }
    .candle-dot.green { background: #00c853; }
    .candle-dot.red   { background: #ff2266; }

    /* Mum badge */
    .candle-badge {
      display: inline-block;
      font-size: 0.58rem;
      font-weight: 700;
      border-radius: 3px;
      padding: 1px 4px;
      vertical-align: middle;
      min-width: 22px;
      text-align: center;
      line-height: 1.2;
    }
    .candle-badge.up { background: var(--green-bg); color: var(--green); border: 1px solid var(--green); }
    .candle-badge.down { background: var(--red-bg); color: var(--red); border: 1px solid var(--red); }

    /* BB %B badge */
    .bb-pct-badge {
      display: inline-block;
      font-size: 0.65rem;
      font-weight: 600;
      border-radius: 4px;
      padding: 2px 6px;
      vertical-align: middle;
      min-width: 54px;
      text-align: center;
      line-height: 1.3;
    }
    .bb-pct-badge.risk { background: var(--red-bg); color: var(--red); }
    .bb-pct-badge.opportunity { background: var(--green-bg); color: var(--green); }
    .bb-pct-badge.neutral { background: rgba(240,185,11,0.1); color: var(--yellow); }

    /* Alarm listesi butonu */
    #alarm-list-btn {
      background: #1a1f35;
      border: 1px solid #2a3f5f;
      border-radius: 6px;
      color: #f0b90b;
      font-size: 0.68rem;
      font-weight: 600;
      padding: 4px 10px;
      min-width: 72px;
      cursor: pointer;
    }
    #alarm-list-btn:hover { background: #2a3f5f; }

    /* NOVA AI butonu */
    #nova-btn {
      background: #8b5cf6;
      color: #fff;
      border: 1px solid #8b5cf6;
      border-radius: 6px;
      padding: 6px 10px;
      font-size: 0.72rem;
      font-weight: 600;
      min-width: 52px;
      cursor: pointer;
      transition: all 0.15s;
    }
    #nova-btn:hover {
      background: #7c3aed;
      border-color: #7c3aed;
    }

    .coin-sym.new-listing { color: var(--purple); }

    .usdt-text {
      font-size: 0.62rem;
      font-weight: 700;
      margin-left: 0;
      color: inherit;
    }

    .new-badge {
      display: inline-block;
      font-size: 0.58rem;
      font-weight: 700;
      background: var(--purple-bg);
      color: var(--purple);
      border: 1px solid rgba(176,127,255,0.4);
      border-radius: 3px;
      padding: 1px 4px;
      margin-left: 3px;
      vertical-align: middle;
    }

    .coin-change {
      font-size: 0.65rem;
      font-weight: 600;
      padding: 2px 6px;
      border-radius: 4px;
      white-space: nowrap;
      flex-shrink: 0;
      min-width: 54px;
      text-align: center;
      display: inline-block;
      line-height: 1.3;
    }

    .coin-change.pos { background: var(--green-bg); color: var(--green); }
    .coin-change.neg { background: var(--red-bg);   color: var(--red); }

    .alarm-btn {
      background: none;
      border: 1px solid rgba(240,185,11,0.3);
      border-radius: 5px;
      color: rgba(240,185,11,0.7);
      font-size: 0.7rem;
      padding: 3px 7px;
      cursor: pointer;
      flex-shrink: 0;
      transition: all 0.15s;
      white-space: nowrap;
    }

    .alarm-btn:hover    { border-color: var(--yellow); color: var(--yellow); background: var(--yellow-bg); }
    .alarm-btn.has-alarm { border-color: var(--purple); color: var(--purple); background: var(--purple-bg); }

    #no-results { text-align: center; color: var(--text-muted); padding: 40px 20px; font-size: 0.88rem; display: none; }
    #no-results.visible { display: block; }

    /* Alarm Modal */
    #modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.7);
      z-index: 500;
      align-items: center;
      justify-content: center;
    }

    #modal-overlay.visible { display: flex; }

    #modal-box {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px 24px;
      width: 320px;
      max-width: 92vw;
    }

    #modal-title {
      font-size: 1rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }

    #modal-coin-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-bottom: 18px;
    }

    .modal-row {
      margin-bottom: 14px;
    }

    .modal-row label {
      display: block;
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 7px;
    }

    .dir-btns {
      display: flex;
      gap: 8px;
    }

    .dir-btn {
      flex: 1;
      padding: 8px;
      border-radius: 7px;
      border: 2px solid var(--border);
      background: var(--card2);
      color: var(--text-muted);
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.15s;
    }

    .dir-btn.selected.green { border-color: var(--green); background: var(--green-bg); color: var(--green); }
    .dir-btn.selected.red   { border-color: var(--red);   background: var(--red-bg);   color: var(--red); }
    .dir-btn:not(.selected):hover { border-color: #50575f; color: var(--text); }

    #modal-tf-select {
      width: 100%;
      background: var(--card2);
      border: 1px solid var(--border);
      border-radius: 7px;
      color: var(--text);
      padding: 8px 10px;
      font-size: 0.85rem;
      cursor: pointer;
    }

    .modal-actions {
      display: flex;
      gap: 8px;
      margin-top: 18px;
    }

    #modal-save {
      flex: 1;
      background: var(--yellow);
      color: #000;
      border: none;
      border-radius: 7px;
      padding: 9px;
      font-size: 0.88rem;
      font-weight: 700;
      cursor: pointer;
      transition: opacity 0.15s;
    }

    #modal-save:hover { opacity: 0.85; }

    #modal-cancel {
      flex: 1;
      background: transparent;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: 7px;
      padding: 9px;
      font-size: 0.88rem;
      cursor: pointer;
      transition: all 0.15s;
    }

    #modal-cancel:hover { border-color: var(--red); color: var(--red); }

    /* Alarm notification */
    #alarm-notif {
      position: fixed;
      bottom: 20px;
      right: 14px;
      z-index: 9999;
      display: flex;
      flex-direction: column-reverse;
      gap: 10px;
      pointer-events: none;
      max-height: calc(100vh - 40px);
      overflow: hidden;
    }

    .notif-card {
      background: #1a1a2e;
      border-radius: 7px;
      padding: 7px 26px 7px 10px;
      min-width: 130px;
      max-width: 160px;
      pointer-events: all;
      animation: slideIn 0.35s cubic-bezier(.22,.68,0,1.2);
      box-shadow: 0 4px 16px rgba(0,0,0,0.5);
      position: relative;
    }

    .notif-card.green { border-left: 3px solid var(--green); border-top: 1px solid rgba(0,220,120,0.2); border-right: 1px solid rgba(0,220,120,0.1); border-bottom: 1px solid rgba(0,220,120,0.1); }
    .notif-card.red   { border-left: 3px solid var(--red);   border-top: 1px solid rgba(255,70,70,0.2);  border-right: 1px solid rgba(255,70,70,0.1);  border-bottom: 1px solid rgba(255,70,70,0.1); }

    .notif-card .notif-sym {
      font-weight: 700;
      font-size: 0.72rem;
      margin-bottom: 2px;
      letter-spacing: 0.2px;
    }

    .notif-card.green .notif-sym { color: var(--green); }
    .notif-card.red   .notif-sym { color: var(--red); }

    .notif-card .notif-dir {
      font-size: 0.62rem;
      font-weight: 600;
      margin-bottom: 2px;
    }
    .notif-card.green .notif-dir { color: var(--green); }
    .notif-card.red   .notif-dir { color: var(--red); }

    .notif-card .notif-time {
      font-size: 0.58rem;
      color: var(--text-muted);
    }

    .notif-close {
      position: absolute;
      top: 3px;
      right: 5px;
      background: none;
      border: none;
      color: #666;
      cursor: pointer;
      font-size: 0.72rem;
      line-height: 1;
      padding: 1px 3px;
      border-radius: 3px;
      transition: color 0.2s;
    }
    .notif-close:hover { color: #ccc; }

    @keyframes slideIn {
      from { transform: translateX(110%); opacity: 0; }
      to   { transform: translateX(0);    opacity: 1; }
    }
  </style>
</head>
<body>

<div id="app-shell">
<header>
  <div id="tf-buttons"></div>
  <div id="tf-action-btns">
    <button id="scan-btn">Tara</button>
    <button id="clear-btn">S&#305;f&#305;rla</button>
    <button id="candle-btn" title="Son mum kontrolü: Kapalı / 3 mum / 4 mum">Mum</button>
    <button id="trend-lock-btn" title="Mevcut listeyi kilitle">Trend</button>
    <span id="trend-lock-badge"></span>
  </div>
  <div id="header-right">
    <div id="header-action-btns">
      <button id="nova-btn">NOVA</button>
      <button id="alarm-list-btn" title="Alarm Listesi">&#128276; ALARM</button>
      <select id="sort-select">
        <option value="volume">&#8597; HG</option>
        <option value="change_asc">&#8593; DY</option>
        <option value="change_desc" selected>&#8595; YD</option>
      </select>
      <label class="auto-scan-wrap">
        <input type="checkbox" id="auto-scan"> 
        <select id="auto-scan-interval" style="padding:3px 6px;font-size:0.75rem;border-radius:6px;border:1px solid #2a3a50;background:#0f1923;color:#cdd9e5;cursor:pointer;">
          <option value="60">60s</option>
          <option value="180">3 DK</option>
          <option value="300">5 DK</option>
          <option value="600">10 DK</option>
        </select>
      </label>
      <span id="countdown-text"></span>
      <div id="conn-indicator">
        <div id="conn-dot"></div>
        <span id="conn-text">Bekliyor</span>
        <span id="last-updated"></span>
      </div>
      <button id="froi-info-btn" style="background:none;border:1px solid #2a3a50;color:#cdd9e5;padding:3px 8px;border-radius:6px;font-size:0.72rem;cursor:pointer;white-space:nowrap;">FR / OI ?</button>
    </div>
</header>

<div class="section">
  <div class="panel">
    <div id="controls">
      <span id="trend-lock-badge-placeholder" style="display:none"></span>
      <div id="btc-status" style="display:inline-flex;align-items:center;gap:4px;margin-left:8px;"></div>
    </div>
    <div id="progress-wrap">
      <div id="progress-bar-bg"><div id="progress-bar"></div></div>
      <div id="progress-text"></div>
    </div>
    <div id="error-box"></div>
  </div>
</div>

<div id="detail-panel">Bir coinin <b>Detay</b> butonuna t&#305;klay&#305;n &mdash; analiz burada g&#246;r&#252;necek.</div>

<div class="section" id="scroll-section">
  <div id="results-count" style="display:none"></div>
  <div id="no-results"></div>
  <div id="results-grid"></div>
</div>
</div>

<!-- FR/OI Info Popup -->
<div id="froi-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;align-items:center;justify-content:center;">
  <div style="background:#0a1929;border:1.5px solid #1e3a5f;border-radius:12px;max-width:420px;width:90%;padding:22px 20px;color:#cdd9e5;font-size:0.85rem;line-height:1.7;max-height:80vh;overflow-y:auto;">
    <h3 style="color:#f0c040;margin:0 0 12px;font-size:1rem;">FR ve OI Nedir?</h3>
    <b>FR &#8212; Funding Rate (Fonlama Oran&#305;)</b><br>
    Futures piyasas&#305;nda longlar ile shortlar aras&#305;nda her 8 saatte bir yap&#305;lan &#246;deme oran&#305;d&#305;r.<br><br>
    <span style="color:#00ff88">&#8226; Negatif FR</span> &#8594; Short'lar long'lara &#246;d&#252;yor. Short kalabali&#287;&#305; var, fiyat yukar&#305; f&#305;rlayabilir (short squeeze riski).<br>
    <span style="color:#ff2266">&#8226; Pozitif Y&#252;ksek FR</span> &#8594; Long'lar short'lara &#246;d&#252;yor. Long kalabal&#305;&#287;&#305; var, d&#252;&#351;&#252;&#351; bask&#305;s&#305; olu&#351;abilir.<br>
    &#8226; S&#305;f&#305;ra yak&#305;n &#8594; Denge var, belirgin bir bask&#305; yok.<br><br>
    <b>OI &#8212; Open Interest (A&#231;&#305;k Pozisyon De&#287;i&#351;imi)</b><br>
    Piyasadaki toplam a&#231;&#305;k pozisyon miktar&#305;n&#305;n son 5 dakikadaki de&#287;i&#351;im y&#252;zdesidir.<br><br>
    <span style="color:#00ff88">&#8226; OI Art&#305;yor &#8593;</span> &#8594; Piyasaya yeni para / pozisyon giriyor. Trendin g&#252;&#231;lendi&#287;ine i&#351;aret edebilir.<br>
    <span style="color:#ff2266">&#8226; OI Azal&#305;yor &#8595;</span> &#8594; Pozisyonlar kapan&#305;yor. Trendin zay&#305;flad&#305;&#287;&#305;na veya tersine&#231;ine i&#351;aret edebilir.<br><br>
    Oklar (&#8593;&#8595;): Son 3+ dakikal&#305;k trend y&#246;n&#252;n&#252; g&#246;sterir. Hen&#252;z yeterli veri yoksa ok g&#246;r&#252;nmez.<br><br>

    <div style="background:#0d1b2a;border:1px solid #1e3a5f;border-radius:8px;padding:12px;margin-top:8px;">
      <div style="font-size:0.9rem;color:#f0c040;margin-bottom:8px;font-weight:bold;">&#128161; Basit Kural:</div>
      <table style="width:100%;font-size:0.78rem;border-collapse:collapse;color:#cdd9e5;">
        <tr style="border-bottom:1px solid #1e3a5f;">
          <th style="text-align:left;padding:4px 6px;font-weight:600;color:#9ca3af;">FR</th>
          <th style="text-align:left;padding:4px 6px;font-weight:600;color:#9ca3af;">OI</th>
          <th style="text-align:left;padding:4px 6px;font-weight:600;color:#9ca3af;">Sonu&#231;</th>
          <th style="text-align:left;padding:4px 6px;font-weight:600;color:#9ca3af;">Anlam&#305;</th>
        </tr>
        <tr>
          <td style="padding:4px 6px;"><span style="color:#ff4d4d;">&#9679; K&#305;rm&#305;z&#305;</span></td>
          <td style="padding:4px 6px;"><span style="color:#ff4d4d;">&#9679; K&#305;rm&#305;z&#305;</span></td>
          <td style="padding:4px 6px;color:#ff4d4d;font-weight:bold;">&#128201; D&#220;&#350;&#220;&#350;</td>
          <td style="padding:4px 6px;color:#aaa;">Long squeeze</td>
        </tr>
        <tr style="background:#0a1425;">
          <td style="padding:4px 6px;"><span style="color:#00ff88;">&#9679; Ye&#351;il</span></td>
          <td style="padding:4px 6px;"><span style="color:#00ff88;">&#9679; Ye&#351;il</span></td>
          <td style="padding:4px 6px;color:#00ff88;font-weight:bold;">&#128200; Y&#220;KSEL&#304;&#350;</td>
          <td style="padding:4px 6px;color:#aaa;">Short squeeze</td>
        </tr>
        <tr>
          <td style="padding:4px 6px;"><span style="color:#ff4d4d;">&#9679; K&#305;rm&#305;z&#305;</span></td>
          <td style="padding:4px 6px;"><span style="color:#00ff88;">&#9679; Ye&#351;il</span></td>
          <td style="padding:4px 6px;color:#f0c040;font-weight:bold;">&#128309; N&#246;tr/Kar&#305;&#351;&#305;k</td>
          <td style="padding:4px 6px;color:#aaa;">Belirsiz</td>
        </tr>
        <tr style="background:#0a1425;">
          <td style="padding:4px 6px;"><span style="color:#00ff88;">&#9679; Ye&#351;il</span></td>
          <td style="padding:4px 6px;"><span style="color:#ff4d4d;">&#9679; K&#305;rm&#305;z&#305;</span></td>
          <td style="padding:4px 6px;color:#f0c040;font-weight:bold;">&#128309; N&#246;tr/Kar&#305;&#351;&#305;k</td>
          <td style="padding:4px 6px;color:#aaa;">Belirsiz</td>
        </tr>
      </table>

      <div style="margin-top:12px;padding-top:10px;border-top:1px solid #1e3a5f;">
        <div style="font-size:0.85rem;color:#f0c040;margin-bottom:6px;font-weight:bold;">&#128161; FET &#214;rne&#287;i:</div>
        <div style="font-size:0.78rem;color:#aaa;line-height:1.6;">
          <div>&#8226; FR: +0.0063% <span style="color:#ff4d4d;">&#9679;</span> (Long bask&#305;s&#305;)</div>
          <div>&#8226; OI: -1.21% <span style="color:#ff4d4d;">&#9679;</span> (Pozisyonlar kapan&#305;yor)</div>
          <div>&#8226; Sonu&#231;: <span style="color:#ff4d4d;">&#9679;&#9679;</span> = Kesin d&#252;&#351;&#252;&#351;</div>
        </div>
      </div>

      <div style="margin-top:10px;padding-top:10px;border-top:1px solid #1e3a5f;">
        <div style="font-size:0.85rem;color:#f0c040;margin-bottom:6px;font-weight:bold;">&#128640; Short Squeeze &#214;rne&#287;i:</div>
        <div style="font-size:0.78rem;color:#aaa;line-height:1.6;">
          <div>&#8226; FR: -0.0080% <span style="color:#00ff88;">&#9679;</span> (Short bask&#305;s&#305;)</div>
          <div>&#8226; OI: +2.50% <span style="color:#00ff88;">&#9679;</span> (Pozisyonlar art&#305;yor)</div>
          <div>&#8226; Sonu&#231;: <span style="color:#00ff88;">&#9679;&#9679;</span> = Kesin y&#252;kseli&#351;</div>
        </div>
      </div>

      <div style="margin-top:14px;padding-top:10px;border-top:1px solid #1e3a5f;">
        <div style="font-size:0.85rem;color:#f0c040;margin-bottom:6px;font-weight:bold;">&#128200; BB %B (Bollinger Band Percent B)</div>
        <div style="font-size:0.78rem;color:#aaa;line-height:1.6;">
          <div>Fiyat&#305;n Bollinger Bantlar&#305; i&#231;indeki g&#246;receli konumunu g&#246;sterir.</div>
          <div><span style="color:#ff4d4d;">&#8226; BB: 80+</span> &#8594; &#220;st bant (&#9888;&#65039; Short f&#305;rsat&#305;)</div>
          <div><span style="color:#f0c040;">&#8226; BB: 50</span> &#8594; Tam orta &#231;izgi (n&#246;tr)</div>
          <div><span style="color:#00ff88;">&#8226; BB: 20 ve alt&#305;</span> &#8594; Alt bant (&#10022; Long f&#305;rsat&#305;)</div>
          <div style="margin-top:6px;color:#666;font-size:0.72rem;">Kartlardaki BB de&#287;eri en b&#252;y&#252;k se&#231;ili TF'ye g&#246;re hesaplan&#305;r.</div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Alarm Listesi Popup -->
<div id="alarms-overlay" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:9998;align-items:flex-start;justify-content:center;padding-top:60px;padding-bottom:16px;">
  <div style="background:#050d1a;border:1.5px solid #1e3a5f;border-radius:12px;width:90%;max-width:420px;height:auto;max-height:calc(100vh - 76px);display:flex;flex-direction:column;overflow:hidden;">
    <div style="display:flex;align-items:center;justify-content:space-between;padding:14px 16px 10px;border-bottom:1px solid #1e3a5f;flex-shrink:0;gap:6px;flex-wrap:wrap;">
      <span style="font-weight:700;color:#f0c040;font-size:0.95rem;">&#9650; Alarm Listesi</span>
      <div style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
        <button id="alarms-sound-btn" title="Ses Aç/Kapat" style="background:#1e3a5f;color:#00d4ff;border:1px solid #1e3a5f;border-radius:6px;padding:4px 10px;font-size:0.75rem;font-weight:700;cursor:pointer;">&#128266; Ses Açık</button>
        <button id="alarms-clear-btn" style="background:#3a1a1a;color:#ff4444;border:1px solid #3a1a1a;border-radius:6px;padding:4px 10px;font-size:0.75rem;font-weight:700;cursor:pointer;">&#128465; Temizle</button>
        <button id="alarms-add-btn" style="background:#f0c040;color:#000;border:none;border-radius:6px;padding:4px 10px;font-size:0.75rem;font-weight:700;cursor:pointer;">+ Yeni Alarm</button>
        <button id="alarms-overlay-close" style="background:none;border:none;color:#888;font-size:1.2rem;cursor:pointer;line-height:1;">&#x2715;</button>
      </div>
    </div>
    <div id="alarms-overlay-list" style="overflow-y:auto;padding:10px 14px;flex:1;scrollbar-width:thin;scrollbar-color:#1e3a5f transparent;"></div>
  </div>
</div>

<!-- Alarm modal -->
<div id="modal-overlay">
  <div id="modal-box">
    <div id="modal-title">Alarm Kur</div>
    <div id="modal-coin-label"></div>
    <div class="modal-row">
      <label>Y&#246;n</label>
      <div class="dir-btns">
        <button class="dir-btn green" data-dir="1">Y&#252;kseli&#351;</button>
        <button class="dir-btn red"   data-dir="2">D&#252;&#351;&#252;&#351;</button>
      </div>
    </div>
    <div class="modal-row">
      <label>Zaman Dilimi</label>
      <select id="modal-tf-select"></select>
    </div>
    <div class="modal-actions">
      <button id="modal-save">Kaydet</button>
      <button id="modal-cancel">&#304;ptal</button>
    </div>
  </div>
</div>

<!-- Alarm notifications -->
<div id="alarm-notif"></div>

<!-- NOVA AI Chat Panel -->
<div id="nova-panel" style="display:none;position:fixed;top:0;right:0;width:100%;max-width:420px;height:100%;background:#0a0e17;border-left:2px solid #f0c040;z-index:10000;flex-direction:column;">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid #1e3a5f;background:#050d1a;">
    <div style="display:flex;align-items:center;gap:10px;">
      <span style="font-weight:800;font-size:1rem;background:linear-gradient(135deg,#f0c040,#ff6b2b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">NOVA AI</span>
      <button id="nova-settings-btn" style="background:none;border:1px solid #2a3f5f;border-radius:4px;padding:4px 8px;font-size:0.65rem;color:#888;cursor:pointer;margin-left:8px;">⚙️ Ayarlar</button>
    </div>
    <button id="nova-close" style="background:none;border:none;color:#888;font-size:1.3rem;cursor:pointer;">&#x2715;</button>
  </div>
  
  <div id="nova-messages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;scrollbar-width:none;-ms-overflow-style:none;"
       onscroll="this.style.scrollbarWidth='none'">
    <div style="background:#1a2744;padding:12px;border-radius:8px;border-left:3px solid #f0c040;">
      <p style="margin:0;font-size:0.8rem;color:#cdd9e5;line-height:1.5;">Merhaba! Ben NOVA. Binance Filter verilerinizle size yardımcı olabilirim. Bir coin hakkında soru sorun veya analiz isteyin.</p>
    </div>
  </div>
  
  <div style="padding:12px 16px;border-top:1px solid #1e3a5f;background:#050d1a;">
    <div style="display:flex;gap:8px;">
      <input id="nova-input" type="text" placeholder="Mesajınızı yazın..." style="flex:1;padding:10px 14px;border:1px solid #2a3f5f;border-radius:6px;background:#0f1923;color:#cdd9e5;font-size:0.85rem;outline:none;">
      <button id="nova-send" style="padding:10px 18px;background:linear-gradient(135deg,#f0c040,#ff6b2b);border:none;border-radius:6px;color:#000;font-weight:700;font-size:0.8rem;cursor:pointer;">Gönder</button>
    </div>
  </div>
</div>

<!-- Mobil/Telefon için Tam Ekran NOVA -->
<div id="nova-fullscreen" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:#0a0e17;z-index:10001;flex-direction:column;">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid #1e3a5f;background:#050d1a;">
    <div style="display:flex;align-items:center;gap:10px;">
      <button id="nova-full-back" style="background:none;border:none;color:#f0c040;font-size:1.2rem;cursor:pointer;padding:4px 8px;">&#8592;</button>
      <span style="font-weight:800;font-size:1rem;background:linear-gradient(135deg,#f0c040,#ff6b2b);-webkit-background-clip:text;-webkit-text-fill-color:transparent;">NOVA AI</span>
      <button id="nova-full-settings-btn" style="background:none;border:1px solid #2a3f5f;border-radius:4px;padding:4px 8px;font-size:0.6rem;color:#888;cursor:pointer;margin-left:8px;">⚙️ Ayarlar</button>
    </div>
  </div>
  
  <div id="nova-full-messages" style="flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:12px;scrollbar-width:none;-ms-overflow-style:none;"
       onscroll="this.style.scrollbarWidth='none'">
    <div style="background:#1a2744;padding:12px;border-radius:8px;border-left:3px solid #f0c040;">
      <p style="margin:0;font-size:0.85rem;color:#cdd9e5;line-height:1.5;">Merhaba! Ben NOVA. Binance Filter verilerinizle size yardımcı olabilirim. Bir coin hakkında soru sorun veya analiz isteyin.</p>
    </div>
  </div>
  
  <div style="padding:12px 16px;border-top:1px solid #1e3a5f;background:#050d1a;">
    <div style="display:flex;gap:8px;">
      <input id="nova-full-input" type="text" placeholder="Mesajınızı yazın..." style="flex:1;padding:12px 16px;border:1px solid #2a3f5f;border-radius:6px;background:#0f1923;color:#cdd9e5;font-size:0.9rem;outline:none;">
      <button id="nova-full-send" style="padding:12px 20px;background:linear-gradient(135deg,#f0c040,#ff6b2b);border:none;border-radius:6px;color:#000;font-weight:700;font-size:0.85rem;cursor:pointer;">Gönder</button>
    </div>
  </div>
</div>

<!-- NOVA Ayarlar Paneli -->
<div id="nova-settings-panel" style="display:none;position:fixed;top:0;right:0;width:100%;max-width:420px;height:100%;background:#0a0e17;border-left:2px solid #f0c040;z-index:10002;flex-direction:column;">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;border-bottom:1px solid #1e3a5f;background:#050d1a;">
    <span style="font-weight:800;font-size:1rem;color:#f0c040;">⚙️ NOVA Ayarları</span>
    <button id="nova-settings-close" style="background:none;border:none;color:#888;font-size:1.3rem;cursor:pointer;">&#x2715;</button>
  </div>
  
  <div style="flex:1;overflow-y:auto;padding:16px;">
    <div style="background:#1a2744;padding:12px;border-radius:8px;margin-bottom:16px;">
      <p style="margin:0 0 12px 0;font-size:0.8rem;color:#cdd9e5;">NOVA'nın sizi tanıması ve size özel konuşması için bilgilerinizi girin. Bu bilgiler sadece cihazınızda saklanır.</p>
    </div>
    
    <div style="margin-bottom:16px;">
      <label style="display:block;font-size:0.75rem;color:#888;margin-bottom:6px;">Adınız / İsminiz</label>
      <input id="nova-user-name" type="text" placeholder="örn: Filiz" style="width:100%;padding:10px 12px;border:1px solid #2a3f5f;border-radius:6px;background:#0f1923;color:#cdd9e5;font-size:0.85rem;box-sizing:border-box;">
    </div>
    
    <div style="margin-bottom:16px;">
      <label style="display:block;font-size:0.75rem;color:#888;margin-bottom:6px;">Hitap Şekli</label>
      <select id="nova-user-tone" style="width:100%;padding:10px 12px;border:1px solid #2a3f5f;border-radius:6px;background:#0f1923;color:#cdd9e5;font-size:0.85rem;">
        <option value="sen">Sen (Samimi)</option>
        <option value="siz">Siz (Resmi)</option>
      </select>
    </div>
    
    <div style="margin-bottom:16px;">
      <label style="display:block;font-size:0.75rem;color:#888;margin-bottom:6px;">Konuşma Tarzı</label>
      <select id="nova-user-style" style="width:100%;padding:10px 12px;border:1px solid #2a3f5f;border-radius:6px;background:#0f1923;color:#cdd9e5;font-size:0.85rem;">
        <option value="samimi">Samimi ve Sıcak</option>
        <option value="profesyonel">Profesyonel ve Ciddi</option>
        <option value="esprili">Eğlenceli ve Esprili</option>
        <option value="sade">Sade ve Net</option>
      </select>
    </div>
    
    <div style="margin-bottom:16px;">
      <label style="display:block;font-size:0.75rem;color:#888;margin-bottom:6px;">Hakkınızda (İsteğe Bağlı)</label>
      <textarea id="nova-user-bio" placeholder="Kendinizden kısaca bahsedin... Mesleğiniz, ilgi alanlarınız vb." style="width:100%;padding:10px 12px;border:1px solid #2a3f5f;border-radius:6px;background:#0f1923;color:#cdd9e5;font-size:0.85rem;min-height:80px;resize:vertical;box-sizing:border-box;"></textarea>
    </div>
    
    <div style="margin-bottom:16px;">
      <label style="display:block;font-size:0.75rem;color:#888;margin-bottom:6px;">NOVA'nın Sizi Nasıl Çağırmasını İstersiniz?</label>
      <input id="nova-user-nickname" type="text" placeholder="örn: Patron, Kaptan, Dostum..." style="width:100%;padding:10px 12px;border:1px solid #2a3f5f;border-radius:6px;background:#0f1923;color:#cdd9e5;font-size:0.85rem;box-sizing:border-box;">
    </div>
    
    <button id="nova-settings-save" style="width:100%;padding:12px;background:linear-gradient(135deg,#f0c040,#ff6b2b);border:none;border-radius:6px;color:#000;font-weight:700;font-size:0.9rem;cursor:pointer;">💾 Kaydet</button>
  </div>
</div>

<script>
const BASE = 'https://fapi.binance.com';

const TIMEFRAMES = [
  { id: '5m',  label: '5D',    minutes: 5 },
  { id: '15m', label: '15D',   minutes: 15 },
  { id: '30m', label: '30D',   minutes: 30 },
  { id: '1h',  label: '1S',    minutes: 60 },
  { id: '2h',  label: '2S',    minutes: 120 },
  { id: '4h',  label: '4S',    minutes: 240 },
  { id: '6h',  label: '6S',    minutes: 360 },
  { id: '8h',  label: '8S',    minutes: 480 },
  { id: '1d',  label: '1G',    minutes: 1440 },
  { id: '1w',  label: '1H',    minutes: 10080 },
  { id: '1M',  label: '1AY',   minutes: 43200 },
];

const STATE = { EMPTY: 0, GREEN: 1, RED: 2 };
const tfStates = Object.fromEntries(TIMEFRAMES.map(tf => [tf.id, STATE.EMPTY]));

let top120 = [];
let coinTFChanges = {};
let newSymbols = new Set();
let scanResults = [];
let trendLocked = false;
let lastScanStats = null;
let lockedCoins = [];
let correctionMap = {};
let countdownInterval = null;
let countdownSec = 0;

// Her uygulama açılışında kalıcı ayarları/alarmları sıfırla
try {
  localStorage.removeItem('bf_alarms');
  localStorage.removeItem('alarm_sound');
  localStorage.removeItem('nova_user_profile');
} catch (e) { /* localStorage kullanılamıyorsa sessiz geç */ }

let alarms = JSON.parse(localStorage.getItem('bf_alarms') || '[]').filter(a => a.symbol && a.symbol.length > 3);
let modalSymbol = '';
let modalDir = 0;
let coinCandleStreaks = {};

/* ---- DOM refs ---- */
const connDot     = document.getElementById('conn-dot');
const connText    = document.getElementById('conn-text');
const scanBtn     = document.getElementById('scan-btn');
const clearBtn    = document.getElementById('clear-btn');
const autoScanCb  = document.getElementById('auto-scan');
const autoScanInterval = document.getElementById('auto-scan-interval');
const lastUpd     = document.getElementById('last-updated');
const cdText      = document.getElementById('countdown-text');
const progWrap    = document.getElementById('progress-wrap');
const progBar     = document.getElementById('progress-bar');
const progText    = document.getElementById('progress-text');
const errBox      = document.getElementById('error-box');
const alarmsPanel = null;
const alarmsList  = null;
const resultsGrid = document.getElementById('results-grid');
const resultsCnt  = document.getElementById('results-count');
const noResults   = document.getElementById('no-results');
const sortSelect  = document.getElementById('sort-select');
const modalOverlay = document.getElementById('modal-overlay');
const modalCoinLbl = document.getElementById('modal-coin-label');
const modalTfSel   = document.getElementById('modal-tf-select');
const modalSaveBtn = document.getElementById('modal-save');
const modalCancelBtn = document.getElementById('modal-cancel');
const alarmNotif  = document.getElementById('alarm-notif');
const trendLockBtn   = document.getElementById('trend-lock-btn');
const trendLockBadge = document.getElementById('trend-lock-badge');
const btcStatusEl    = document.getElementById('btc-status');
const candleBtn      = document.getElementById('candle-btn');

// Mum kontrolü: 0=kapalı, 1=aktif (ON)
let candleMode = 0;

candleBtn.addEventListener('click', () => {
  candleMode = candleMode === 0 ? 1 : 0;
  if (candleMode === 1) { candleBtn.textContent = 'Mum ON'; candleBtn.className = 'active'; }
  else { candleBtn.textContent = 'Mum'; candleBtn.className = ''; }
  forceNextFullRender = true;
  if (scanResults.length) renderResults(scanResults, getActiveTFs());
});

/* ---- WebSocket ticker ---- */
const WS_BASE = 'wss://fstream.binance.com';
let wsTickerData = {};
let wsTicker = null;
let wsReconnectTimer = null;

function connectTickerWS() {
  if (wsTicker && wsTicker.readyState <= 1) return;
  clearTimeout(wsReconnectTimer);
  try {
    wsTicker = new WebSocket(`${WS_BASE}/ws/!miniTicker@arr`);

    wsTicker.onopen = () => {
      connDot.className = 'online';
      connText.textContent = 'Ba\u011Fl\u0131';
    };

    wsTicker.onmessage = (e) => {
      try {
        const list = JSON.parse(e.data);
        list.forEach(t => {
          const close = parseFloat(t.c);
          const open  = parseFloat(t.o);
          wsTickerData[t.s] = {
            change: open > 0 ? ((close - open) / open) * 100 : 0,
            volume: parseFloat(t.q),
            price:  close,
          };
        });
        connDot.className = 'online';
        connText.textContent = 'Ba\u011Fl\u0131';
      } catch {}
    };

    wsTicker.onerror = () => {
      connDot.className = 'offline';
      connText.textContent = 'WS Hatas\u0131';
    };

    wsTicker.onclose = () => {
      connDot.className = 'offline';
      connText.textContent = 'Yeniden ba\u011Flan\u0131yor...';
      wsReconnectTimer = setTimeout(connectTickerWS, 4000);
    };
  } catch {
    connDot.className = 'offline';
    connText.textContent = 'Ba\u011Flant\u0131 Yok';
    wsReconnectTimer = setTimeout(connectTickerWS, 5000);
  }
}

/* ---- Max mum zinciri kontrolü: 4→3→2 (tek API çağrısı) ---- */
async function checkMaxConsecutiveCandles(symbol, interval, expectedColor) {
  try {
    const url = `${BASE}/fapi/v1/klines?symbol=${symbol}&interval=${interval}&limit=4`;
    const r = await fetchWithRetry(url, 1, 500);
    const klines = await r.json();
    if (!klines || klines.length < 2) return { count: 0, direction: null };
    for (let n = 4; n >= 2; n--) {
      if (klines.length >= n) {
        const lastN = klines.slice(-n);
        const allSame = lastN.every(k => {
          const open = parseFloat(k[1]);
          const close = parseFloat(k[4]);
          if (expectedColor === 'green') return close > open;
          if (expectedColor === 'red') return close < open;
          return false;
        });
        if (allSame) return { count: n, direction: expectedColor };
      }
    }
    return { count: 0, direction: null };
  } catch (e) {
    return { count: 0, direction: null };
  }
}

/* ---- Klines cache ---- */
const klineCache = {};
const TF_MS = { '5m':300000,'15m':900000,'30m':1800000,'1h':3600000,'2h':7200000,'4h':14400000,'6h':21600000,'8h':28800000,'1d':86400000,'1w':604800000,'1M':2592000000 };

/* ---- Son N mum aynı renk kontrolü ---- */
async function checkLastNCandlesSameColor(symbol, interval, n, expectedColor) {
  try {
    const url = `${BASE}/fapi/v1/klines?symbol=${symbol}&interval=${interval}&limit=${n}`;
    const r = await fetchWithRetry(url, 1, 500);
    const klines = await r.json();
    if (!klines || klines.length < n) return false;
    const lastN = klines.slice(-n);
    return lastN.every(k => {
      const open = parseFloat(k[1]);
      const close = parseFloat(k[4]);
      if (expectedColor === 'green') return close > open;
      if (expectedColor === 'red') return close < open;
      return false;
    });
  } catch (e) {
    return false;
  }
}

/* ---- Build UI ---- */
function buildTFButtons() {
  const container = document.getElementById('tf-buttons');
  TIMEFRAMES.forEach(tf => {
    const btn = document.createElement('button');
    btn.className = 'tf-btn';
    btn.id = 'btn-' + tf.id;
    btn.textContent = tf.label;
    btn.addEventListener('click', () => cycleTF(tf.id));
    container.appendChild(btn);
  });
}

function buildModalTFSelect() {
  TIMEFRAMES.forEach(tf => {
    const opt = document.createElement('option');
    opt.value = tf.id;
    opt.textContent = tf.label;
    modalTfSel.appendChild(opt);
  });
}

/* ---- TF state cycle ---- */
function cycleTF(id) {
  tfStates[id] = (tfStates[id] + 1) % 3;
  const btn = document.getElementById('btn-' + id);
  btn.className = 'tf-btn';
  if (tfStates[id] === STATE.GREEN) btn.classList.add('green');
  else if (tfStates[id] === STATE.RED) btn.classList.add('red');
  forceNextFullRender = true;
}

function updateTFButtons() {
  TIMEFRAMES.forEach(tf => {
    const btn = document.getElementById('btn-' + tf.id);
    if (!btn) return;
    btn.className = 'tf-btn';
    if (tfStates[tf.id] === STATE.GREEN) btn.classList.add('green');
    else if (tfStates[tf.id] === STATE.RED) btn.classList.add('red');
  });
}

function getActiveTFs() {
  return TIMEFRAMES.filter(tf => tfStates[tf.id] !== STATE.EMPTY);
}

function getLargestActiveTF() {
  const active = getActiveTFs();
  if (!active.length) return null;
  return active.reduce((a, b) => b.minutes > a.minutes ? b : a);
}

function getSmallestActiveTF() {
  const active = getActiveTFs();
  if (!active.length) return null;
  return active.reduce((a, b) => b.minutes < a.minutes ? b : a);
}

function calcCorrection(symbol, bbData) {
  if (!trendLocked) return null;
  const active = getActiveTFs();
  if (active.length < 2) return null;
  const bigTF = getLargestActiveTF();
  const smallTF = getSmallestActiveTF();
  if (!bigTF || !smallTF || bigTF.id === smallTF.id) return null;
  const bigState = bbData[symbol] && bbData[symbol][bigTF.id];
  const smallState = bbData[symbol] && bbData[symbol][smallTF.id];
  if (bigState === null || bigState === undefined || smallState === null || smallState === undefined) return null;
  if (bigState === smallState) return null;
  if (bigState === STATE.GREEN && smallState === STATE.RED) return 'pullback';
  if (bigState === STATE.RED && smallState === STATE.GREEN) return 'bounce';
  return null;
}

/* ---- API calls ---- */
async function fetchWithRetry(url, retries = 3, delayMs = 1500) {
  for (let i = 0; i < retries; i++) {
    try {
      const ctrl = new AbortController();
      const tid = setTimeout(() => ctrl.abort(), 10000);
      const r = await fetch(url, { signal: ctrl.signal });
      clearTimeout(tid);
      if (r.ok) return r;
      if (r.status === 429) {
        progText.textContent = `Hiz siniri (429) \u2014 ${delayMs * (i + 1) / 1000}s bekleniyor...`;
        await sleep(delayMs * (i + 1));
        continue;
      }
      throw new Error(`HTTP ${r.status}`);
    } catch (e) {
      if (i === retries - 1) throw e;
      progText.textContent = `Baglanti hatasi, yeniden deneniyor (${i + 2}/${retries})...`;
      await sleep(delayMs);
    }
  }
  throw new Error('Baglanti saglanamadi');
}

async function getTop120() {
  const wsEntries = Object.entries(wsTickerData).filter(([s]) => s.endsWith('USDT') && !s.includes('_'));
  if (wsEntries.length >= 100) {
    return wsEntries
      .sort((a, b) => (b[1]?.volume || 0) - (a[1]?.volume || 0))
      .slice(0, 250)
      .map(([symbol, data]) => ({ symbol, change: data.change || 0, volume: data.volume || 0 }));
  }
  const url = `${BASE}/fapi/v1/ticker/24hr`;
  const r = await fetchWithRetry(url);
  const data = await r.json();
  return data
    .filter(s => s.symbol.endsWith('USDT') && !s.symbol.includes('_'))
    .sort((a, b) => parseFloat(b.volume) - parseFloat(a.volume))
    .slice(0, 250)
    .map(s => ({ symbol: s.symbol, change: parseFloat(s.priceChangePercent), volume: parseFloat(s.volume) }));
}

async function getAllUSDTCoins() {
  const url = `${BASE}/fapi/v1/ticker/24hr`;
  const r = await fetchWithRetry(url);
  const data = await r.json();
  return data
    .filter(s => s.symbol.endsWith('USDT') && !s.symbol.includes('_'))
    .map(s => ({ symbol: s.symbol, change: parseFloat(s.priceChangePercent), volume: parseFloat(s.volume) }));
}

function shouldScanAllUSDT(activeTFs) {
  const bigTFs = activeTFs.filter(tf => ['1d', '1w', '1M'].includes(tf.id));
  const smallTFs = activeTFs.filter(tf => !['1d', '1w', '1M'].includes(tf.id));
  return bigTFs.length > 0 && smallTFs.length === 0;
}

async function fetchNewSymbols() {
  try {
    const r = await fetch(`${BASE}/fapi/v1/exchangeInfo`);
    if (!r.ok) return new Set();
    const data = await r.json();
    const now = Date.now();
    const NINETY = 90 * 24 * 60 * 60 * 1000;
    const s = new Set();
    (data.symbols || []).forEach(sym => {
      if (sym.onboardDate && (now - sym.onboardDate) < NINETY) {
        s.add(sym.symbol);
      }
    });
    return s;
  } catch { return new Set(); }
}

async function fetchBBState(symbol, interval) {
  try {
    const cacheKey = `${symbol}_${interval}`;
    const ttl = TF_MS[interval] || 300000;
    const cached = klineCache[cacheKey];
    if (cached && (Date.now() - cached.time) < ttl) {
      return cached.state;
    }
    const BB_PERIOD = 20;
    const BB_STDDEV = 2;
    const r = await fetchWithRetry(`${BASE}/fapi/v1/klines?symbol=${symbol}&interval=${interval}&limit=${BB_PERIOD + 1}`, 2, 1000);
    const klines = await r.json();
    if (klines.length < BB_PERIOD + 1) return null;

    // All closes including current (last) candle
    const allCloses = klines.map(k => parseFloat(k[4]));
    // SMA: average of last BB_PERIOD closes (includes current candle)
    const smaCloses = allCloses.slice(1); // klines[1..20], most recent 20
    const sma = smaCloses.reduce((a, b) => a + b, 0) / BB_PERIOD;

    // Population standard deviation
    const variance = smaCloses.reduce((sum, c) => sum + Math.pow(c - sma, 2), 0) / BB_PERIOD;
    const stddev = Math.sqrt(variance);

    // Bollinger Bands
    const upper = sma + BB_STDDEV * stddev;
    const lower = sma - BB_STDDEV * stddev;

    const lastClose = allCloses[allCloses.length - 1];
    const lastOpen  = parseFloat(klines[klines.length - 1][1]);
    const pctChange = lastOpen > 0 ? ((lastClose - lastOpen) / lastOpen) * 100 : 0;
    coinTFChanges[symbol] = coinTFChanges[symbol] || {};
    coinTFChanges[symbol][interval] = pctChange;

    // Canonical BB signal logic (trend-following)
    let state;
    if (lastClose > upper)      state = STATE.GREEN;   // band breakout up
    else if (lastClose < lower) state = STATE.RED;     // band breakout down
    else if (lastClose > sma)   state = STATE.GREEN;   // above MA inside bands
    else if (lastClose < sma)   state = STATE.RED;     // below MA inside bands
    else                        state = null;           // exactly at MA → neutral

    klineCache[cacheKey] = { state, upper, lower, lastClose, time: Date.now() };
    return state;
  } catch { return null; }
}

function getBBPctB(symbol, interval) {
  const cached = klineCache[`${symbol}_${interval}`];
  if (!cached || cached.upper === undefined || cached.lower === undefined || cached.lastClose === undefined) return null;
  const range = cached.upper - cached.lower;
  if (range <= 0) return null;
  return ((cached.lastClose - cached.lower) / range) * 100;
}

/* ---- Teknik Gosterge Hesaplama ---- */
function calcRSI(closes, period = 14) {
  if (closes.length < period + 1) return null;
  // Simple average gain/loss over the last period candles (not Wilder)
  let gains = 0, losses = 0;
  for (let i = closes.length - period; i < closes.length; i++) {
    const diff = closes[i] - closes[i - 1];
    if (diff > 0) gains += diff;
    else losses -= diff;
  }
  const avgGain = gains / period;
  const avgLoss = losses / period;
  if (avgLoss === 0) return 100;
  const rs = avgGain / avgLoss;
  return 100 - (100 / (1 + rs));
}

function calcMACD(closes) {
  if (closes.length < 26) return null;
  const ema12 = [];
  const ema26 = [];
  let e12 = closes[0], e26 = closes[0];
  const k12 = 2 / 13, k26 = 2 / 27;
  for (let i = 0; i < closes.length; i++) {
    e12 = closes[i] * k12 + e12 * (1 - k12);
    e26 = closes[i] * k26 + e26 * (1 - k26);
    ema12.push(e12);
    ema26.push(e26);
  }
  const macdLine = ema12.map((v, i) => v - ema26[i]);
  let signal = macdLine[0];
  const k9 = 2 / 10;
  for (let i = 1; i < macdLine.length; i++) {
    signal = macdLine[i] * k9 + signal * (1 - k9);
  }
  const last = macdLine[macdLine.length - 1];
  const prev = macdLine[macdLine.length - 2];
  const prevSig = macdLine.length > 2 ? (function() {
    let s = macdLine[0]; for (let i = 1; i < macdLine.length - 1; i++) s = macdLine[i] * k9 + s * (1 - k9); return s;
  })() : signal;
  return {
    macd: last,
    signal,
    crossUp: prev < prevSig && last > signal,
    crossDown: prev > prevSig && last < signal,
    bullish: last > signal,
  };
}

function calcVolumeSpike(volumes, lookback = 20) {
  if (volumes.length < lookback + 1) return null;
  const avg = volumes.slice(0, lookback).reduce((a, b) => a + b, 0) / lookback;
  const last = volumes[volumes.length - 1];
  if (avg === 0) return null;
  return last / avg;
}

async function fetchIndicators(symbol, interval) {
  try {
    const cacheKey = `ind_${symbol}_${interval}`;
    const ttl = TF_MS[interval] || 300000;
    const cached = klineCache[cacheKey];
    if (cached && (Date.now() - cached.time) < ttl) return cached.data;

    const r = await fetchWithRetry(`${BASE}/fapi/v1/klines?symbol=${symbol}&interval=${interval}&limit=50`, 2, 1000);
    const klines = await r.json();
    if (klines.length < 30) return null;

    const closes = klines.map(k => parseFloat(k[4]));
    const volumes = klines.map(k => parseFloat(k[5]));

    const rsi = calcRSI(closes);
    const macd = calcMACD(closes);
    const volSpike = calcVolumeSpike(volumes);

    // Son 3 mum rengi - ileride kullanılabilir
    const last3 = klines.slice(-3).map(k => parseFloat(k[4]) >= parseFloat(k[1]) ? 'g' : 'r');

    let rsiSignal = 'neutral';
    if (rsi !== null) {
      if (rsi < 30) rsiSignal = 'bullish';
      else if (rsi > 70) rsiSignal = 'bearish';
    }

    let macdSignal = 'neutral';
    if (macd) {
      if (macd.crossUp) macdSignal = 'bullish';
      else if (macd.crossDown) macdSignal = 'bearish';
      else if (macd.bullish) macdSignal = 'bullish';
      else macdSignal = 'bearish';
    }

    let volSignal = 'neutral';
    if (volSpike !== null && volSpike >= 2.0) {
      const lastClose = closes[closes.length - 1];
      const prevClose = closes[closes.length - 2];
      volSignal = lastClose >= prevClose ? 'bullish' : 'bearish';
    }

    const data = {
      rsi: rsi !== null ? Math.round(rsi) : null,
      rsiSignal,
      macdSignal,
      macdCross: macd ? (macd.crossUp ? 'up' : macd.crossDown ? 'down' : null) : null,
      volSpike: volSpike !== null ? volSpike.toFixed(1) : null,
      volSignal,
      last3,
    };

    klineCache[cacheKey] = { data, time: Date.now() };
    return data;
  } catch { return null; }
}

/* ---- Long/Short Oran Analizi (Gercek Acik Pozisyonlar) ---- */
async function fetchLongShortRatio(symbol, interval) {
  try {
    const r1 = await fetchWithRetry(
      `${BASE}/futures/data/topLongShortAccountRatio?symbol=${symbol}&period=${interval}&limit=1`, 2, 1000
    );
    const d1 = await r1.json();

    const r2 = await fetchWithRetry(
      `${BASE}/futures/data/topLongShortPositionRatio?symbol=${symbol}&period=${interval}&limit=1`, 2, 1000
    );
    const d2 = await r2.json();

    if (!d1.length || !d2.length) return null;

    const accRatio  = parseFloat(d1[0].longShortRatio);
    const posRatio  = parseFloat(d2[0].longShortRatio);
    const accLong   = parseFloat(d1[0].longAccount);
    const accShort  = parseFloat(d1[0].shortAccount);

    let signal = 'neutral';
    if (accRatio > 1.3 && posRatio > 1.3) signal = 'bullish';
    else if (accRatio < 0.77 && posRatio < 0.77) signal = 'bearish';
    else if (accRatio > 1.15 && posRatio > 1.15) signal = 'bullish';
    else if (accRatio < 0.87 && posRatio < 0.87) signal = 'bearish';

    return {
      accRatio: accRatio.toFixed(2),
      posRatio: posRatio.toFixed(2),
      longPct: (accLong * 100).toFixed(1),
      shortPct: (accShort * 100).toFixed(1),
      signal,
    };
  } catch { return null; }
}

/* ---- Birlesik Sinyal Hesaplama ---- */
function calcCompositeSignal(indicators, lsData, frData) {
  let bullCount = 0, bearCount = 0;

  if (indicators) {
    if (indicators.rsiSignal === 'bullish') bullCount++;
    else if (indicators.rsiSignal === 'bearish') bearCount++;
    if (indicators.macdSignal === 'bullish') bullCount++;
    else if (indicators.macdSignal === 'bearish') bearCount++;
    if (indicators.volSignal === 'bullish') bullCount++;
    else if (indicators.volSignal === 'bearish') bearCount++;
  }

  if (lsData) {
    if (lsData.signal === 'bullish') bullCount++;
    else if (lsData.signal === 'bearish') bearCount++;
  }

  if (frData) {
    if (frData.signal === 'bullish') bullCount++;
    else if (frData.signal === 'bearish') bearCount++;
  }

  const total = bullCount + bearCount;
  if (total === 0) return null;

  if (frData && frData.fundingRate > 0.0005 && bullCount >= 5) bullCount--;
  if (frData && frData.fundingRate < -0.0005 && bearCount >= 5) bearCount--;

  if (bullCount >= 4) return 'bullish';
  if (bearCount >= 4) return 'bearish';
  return null;
}

function playSignalSound(type) {
  if (!window.alarmSoundEnabled) return;
  try {
    var b64 = (type === 'bullish') ? YUKSELIS_B64 : DUSUS_B64;
    var audio = new Audio('data:audio/mp3;base64,' + b64);
    audio.volume = 1.0;
    audio.play();
  } catch(e) {}
}

let prevSignals = {};
let obInterval = null;
let coinIndicators = {};
let coinLSData = {};
let coinFRData = {};
let forceNextFullRender = false;
const DUSUS_B64 = "";
const YUKSELIS_B64 = "";

async function fetchFundingOI(symbol) {
  try {
    const [frRes, oiRes, oiHistRes] = await Promise.all([
      fetchWithRetry(`${BASE}/fapi/v1/premiumIndex?symbol=${symbol}`, 2, 1000),
      fetchWithRetry(`${BASE}/fapi/v1/openInterest?symbol=${symbol}`, 2, 1000),
      fetchWithRetry(`${BASE}/futures/data/openInterestHist?symbol=${symbol}&period=5m&limit=3`, 2, 1000)
    ]);
    const frData   = await frRes.json();
    const oiData   = await oiRes.json();
    const oiHist   = await oiHistRes.json();

    const fundingRate = parseFloat(frData.lastFundingRate);
    const currentOI   = parseFloat(oiData.openInterest);
    const prevOI      = oiHist.length >= 2 ? parseFloat(oiHist[oiHist.length - 2].sumOpenInterest) : currentOI;
    const oiChange    = prevOI > 0 ? ((currentOI - prevOI) / prevOI) * 100 : 0;

    let signal = 'neutral';
    // KESİŞİM SİNYALLERİ - GÜÇLÜ ONAY
    // FR Yeşil + OI Yeşil = KESİNLİKLE YÜKSELİŞ
    if (fundingRate < -0.0001 && oiChange > 0.3)       signal = 'bullish';
    // FR Kırmızı + OI Kırmızı = KESİNLİKLE DÜŞÜŞ
    else if (fundingRate > 0.0005 && oiChange < -0.3)   signal = 'bearish';
    
    // GÜÇLÜ TEK SİNYALLER
    // Strong Short: Çok yüksek short pozisyon → yükseliş potansiyeli
    else if (fundingRate < -0.0005)                     signal = 'bullish';
    // Long Squeeze: Alıcılar fazla + OI artıyor → düşüş baskısı
    else if (fundingRate > 0.0008 && oiChange > 0.3)   signal = 'bearish';
    // Position Closing: Pozisyonlar hızla kapanıyor → trend dönebilir
    else if (oiChange < -0.5)                           signal = 'bearish';
    // Mild Short: Hafif short baskısı → yukarı yönlü
    else if (fundingRate < 0 && oiChange > 0.1)         signal = 'bullish';

    return { fundingRate, currentOI, oiChange, signal };
  } catch { return null; }
}

async function runDeepAnalysis() {
  if (!scanResults.length) return;
  const analyzeList = scanResults.slice(0, 30);
  const active = getActiveTFs();
  if (!active.length) return;
  const largest = active.reduce((a, b) => b.minutes > a.minutes ? b : a, active[0]);

  const lsPeriod = largest.minutes >= 1440 ? '1d' :
                   largest.minutes >= 240  ? '4h' :
                   largest.minutes >= 60   ? '1h' :
                   largest.minutes >= 15   ? '15m' : '5m';

  for (const coin of analyzeList) {
    const ind = await fetchIndicators(coin.symbol, largest.id);
    if (ind) coinIndicators[coin.symbol] = ind;
    const ls = await fetchLongShortRatio(coin.symbol, lsPeriod);
    if (ls) coinLSData[coin.symbol] = ls;
    const fr = await fetchFundingOI(coin.symbol);
    if (fr) coinFRData[coin.symbol] = fr;
    await sleep(150);
  }

  for (const coin of analyzeList) {
    const ind = coinIndicators[coin.symbol];
    const ls  = coinLSData[coin.symbol];
    const fr  = coinFRData[coin.symbol];
    const sig = calcCompositeSignal(ind, ls, fr);
    const prev = prevSignals[coin.symbol];
    if (sig && sig !== prev) {
      // sinyal sesi kaldirildi - sadece alarm tetiklenince ses calar
    }
    prevSignals[coin.symbol] = sig;
  }

  updateCardSignals();

  // İlk 30 dışındaki coinlerin FR/OI verisini arka planda çek
  const remaining = scanResults.slice(30);
  for (const coin of remaining) {
    if (coinFRData[coin.symbol]) continue; // zaten varsa atla
    const fr = await fetchFundingOI(coin.symbol);
    if (fr) {
      coinFRData[coin.symbol] = fr;
      // Kartı güncelle
      const card = document.querySelector(`.coin-card[data-symbol="${coin.symbol}"]`);
      if (card) {
        const frSpan = card.querySelector('.fr-val');
        const oiSpan = card.querySelector('.oi-val');
        if (frSpan) {
          frSpan.textContent = (fr.fundingRate * 100).toFixed(4) + '%';
          frSpan.style.color = fr.fundingRate < 0 ? '#00ff88' : fr.fundingRate > 0.0005 ? '#ff2266' : '#aaa';
        }
        if (oiSpan) {
          const oiVal = (fr.oiChange >= 0 ? '+' : '') + fr.oiChange.toFixed(2) + '%';
          oiSpan.textContent = oiVal;
          oiSpan.style.color = fr.oiChange > 0.3 ? '#00ff88' : fr.oiChange < -0.5 ? '#ff2266' : '#aaa';
        }
      }
    }
    await sleep(120);
  }
}

async function batchProcess(symbols, activeTFs, onProgress) {
  const BATCH = 8;  // Reduced from 15 to avoid rate limiting
  const results = {};
  symbols.forEach(s => { results[s.symbol] = {}; });
  let coinDone = 0;
  const totalCoins = symbols.length;
  const totalTFs = activeTFs.length;

  for (let i = 0; i < symbols.length; i += BATCH) {
    const batch = symbols.slice(i, i + BATCH);
    const tasks = batch.flatMap(coin =>
      activeTFs.map(tf =>
        fetchBBState(coin.symbol, tf.id).then(state => {
          results[coin.symbol][tf.id] = state;
        })
      )
    );
    await Promise.all(tasks);
    coinDone += batch.length;
    const pct = Math.round((coinDone / totalCoins) * 100);
    onProgress(coinDone, totalCoins, pct, totalTFs);
    if (i + BATCH < symbols.length) await sleep(150);  // Increased delay between batches
  }
  return results;
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

/* ---- Trend Lock ---- */
function toggleTrendLock() {
  trendLockBtn.classList.remove('pulse');
  if (!trendLocked) {
    if (!scanResults.length) { showError('Once tarama yapin, ardindan Trend\'i aktif edin.'); return; }
    trendLocked = true;
    lockedCoins = scanResults.map(c => ({ symbol: c.symbol, change: c.change, volume: c.volume }));
    trendLockBtn.classList.add('active');
    trendLockBtn.textContent = 'Trend ON';
    trendLockBadge.textContent = '\uD83D\uDD12 ' + lockedCoins.length;
    trendLockBadge.classList.add('visible');
    // Kilitli coinlerin hepsini goster (henuz filtre yok)
    scanResults = lockedCoins.map(c => ({ ...c }));
    renderResults(scanResults, []);
    resultsCnt.innerHTML = `Kilitli: <span>${lockedCoins.length}</span> coin (zaman dilimi secip filtrele)`;
    runDeepAnalysis();
    obInterval = setInterval(runDeepAnalysis, 30000);
  } else {
    trendLocked = false;
    lockedCoins = [];
    trendLockBtn.classList.remove('active');
    trendLockBtn.textContent = 'Trend';
    trendLockBadge.classList.remove('visible');
    if (obInterval) { clearInterval(obInterval); obInterval = null; }
    resultsGrid.innerHTML = '';
    resultsCnt.innerHTML = '';
    noResults.classList.remove('visible');
    showError('Trend kilidi acildi. Yeni tarama baslatabilirsiniz.');
  }
}

trendLockBtn.addEventListener('click', toggleTrendLock);

/* ---- Scan ---- */
async function runScan() {
  const active = getActiveTFs();
  const hasAlarms = alarms.some(a => !a.triggered);

  if (!active.length && !hasAlarms) { showError('Lutfen en az bir zaman dilimi secin.'); return; }

  hideError();
  scanBtn.disabled = true;
  scanBtn.textContent = '...';
  scanBtn.classList.add('scanning');
  scanBtn.style.setProperty('--scan-progress', '0');
  trendLockBtn.classList.remove('pulse');
  progWrap.classList.add('visible');
  progBar.style.width = '0%';

  // Clear kline cache for fresh BB data each scan
  for (const key in klineCache) delete klineCache[key];
  coinTFChanges = {};

  try {
    let scanPool;
    let marketAnalysisCoins = [];

    if (trendLocked && lockedCoins.length) {
      progText.textContent = `Trend Kilidi: ${lockedCoins.length} coin taraniyor...`;
      scanPool = lockedCoins;
      marketAnalysisCoins = scanPool;
    } else {
      if (active.length) { resultsGrid.innerHTML = ''; noResults.classList.remove('visible'); }
      
      // İki aşamalı tarama mantığı
      const scanAllUSDT = shouldScanAllUSDT(active);
      
      if (scanAllUSDT) {
        // Aşama 1: İlk 250 coin
        progText.textContent = '250/1. aşama taranıyor...';
        top120 = await getTop120();
        scanPool = top120;
      } else {
        // Normal tarama: 250 coin
        progText.textContent = 'En yuksek hacimli 250 coin aliniyor...';
        top120 = await getTop120();
        scanPool = top120;
        marketAnalysisCoins = scanPool;
      }
    }

    if (newSymbols.size === 0) {
      newSymbols = await fetchNewSymbols();
    }

    /* Alarm TF'lerini de ekle (filtre seçili olmasa bile veri çek) */
    const alarmTFIds = [...new Set(alarms.filter(a => !a.triggered).map(a => a.tfId))];
    const alarmTFs = TIMEFRAMES.filter(tf => alarmTFIds.includes(tf.id) && !active.find(a => a.id === tf.id));
    const allTFs = [...active, ...alarmTFs];

    /* Alarm coinlerini scanPool'a ekle (listede yoksa) */
    const alarmSymbols = alarms.filter(a => !a.triggered).map(a => a.symbol);
    const poolSymbols = new Set(scanPool.map(c => c.symbol));
    const extraCoins = alarmSymbols.filter(s => !poolSymbols.has(s)).map(s => ({ symbol: s, change: 0, volume: 0 }));
    const fullPool = allTFs.length ? [...scanPool, ...extraCoins] : [];

    let bbData = {};
    if (allTFs.length && fullPool.length) {
      progText.textContent = `BB hesaplan\u0131yor... (0 / ${fullPool.length} coin)`;
      bbData = await batchProcess(fullPool, allTFs, (coinDone, totalCoins, pct, totalTFs) => {
        const isFullScan = shouldScanAllUSDT(active);
        const displayPct = isFullScan ? (pct / 2) : pct;
        progBar.style.width = displayPct + '%';
        scanBtn.style.setProperty('--scan-progress', (pct / 100));
        progText.textContent = `BB hesaplanıyor... (${coinDone} / ${totalCoins} coin, ${totalTFs} TF)`;
      });
    }

    if (active.length) {
      let matched;
      if (trendLocked && active.length === 0) {
        // Trend kilidi aktif ama hic zaman dilimi secilmemis: tum kilitli coinleri goster
        matched = scanPool.map(coin => {
          const fresh = wsTickerData[coin.symbol];
          return {
            ...coin,
            change: fresh ? fresh.change : coin.change,
            volume: fresh ? fresh.volume : coin.volume,
            bbData: bbData[coin.symbol],
          };
        });
      } else {
        // Normal mod VEYA trend kilidi + zaman dilimi secili: filtrele
        const poolToFilter = trendLocked ? lockedCoins : scanPool;
        matched = await Promise.all(poolToFilter.map(async coin => {
          // BB filtresi kontrolü
          const bbMatch = active.every(tf => {
            const s = bbData[coin.symbol] && bbData[coin.symbol][tf.id];
            return s !== null && s === tfStates[tf.id];
          });
          if (!bbMatch) return null;

          const fresh = wsTickerData[coin.symbol];
          return {
            ...coin,
            change: fresh ? fresh.change : coin.change,
            volume: fresh ? fresh.volume : coin.volume,
            bbData: bbData[coin.symbol],
          };
        }));
        matched = matched.filter(coin => coin !== null);
      }
      scanResults = matched;
      renderResults(matched, active);

      // Mum butonu aktifse: her coin için max mum zincirini bul ve badge olarak göster
      if (candleMode === 1 && matched.length) {
        const smallestTF = active.slice().sort((a, b) => a.minutes - b.minutes)[0];
        if (smallestTF) {
          const CANDLE_BATCH = 8;
          for (let i = 0; i < matched.length; i += CANDLE_BATCH) {
            const batch = matched.slice(i, i + CANDLE_BATCH);
            const tasks = batch.map(async coin => {
              const bbState = bbData[coin.symbol] && bbData[coin.symbol][smallestTF.id];
              let expectedColor = null;
              if (bbState === STATE.GREEN) expectedColor = 'green';
              else if (bbState === STATE.RED) expectedColor = 'red';
              if (!expectedColor) return { symbol: coin.symbol, count: 0, direction: null };
              const result = await checkMaxConsecutiveCandles(coin.symbol, smallestTF.id, expectedColor);
              return { symbol: coin.symbol, ...result };
            });
            const results = await Promise.all(tasks);
            results.forEach(({ symbol, count, direction }) => {
              coinCandleStreaks[symbol] = count > 0 ? { count, direction } : null;
            });
            if (i + CANDLE_BATCH < matched.length) await sleep(150);
          }
          // Badge'leri göstermek için kartları yenile
          forceNextFullRender = true;
          renderResults(matched, active);
        }
      }
    }

    checkAlarms(bbData, fullPool);

    // Düzeltme analizi: trend kilidi + 2+ aktif TF varsa hesapla
    correctionMap = {};
    if (trendLocked && active.length >= 2) {
      scanResults.forEach(coin => {
        const corr = calcCorrection(coin.symbol, bbData);
        if (corr) correctionMap[coin.symbol] = corr;
      });
    }

    // İki aşamalı tarama - ikinci aşama
    const scanAllUSDT = shouldScanAllUSDT(active);
    if (scanAllUSDT && !trendLocked) {
      // İlk sonuçları göster
      const now = new Date();
      lastUpd.textContent = now.toLocaleTimeString('tr-TR');
      
      // 5 saniye bekle ve ikinci aşamayı başlat
      progText.textContent = `İlk 250 coin tarandı. İkinci aşama için 5 saniye bekleniyor...`;
      progBar.style.width = '50%';
      
      for (let i = 5; i > 0; i--) {
        progText.textContent = `5sn geri sayım: ${i}`;
        await sleep(1000);
      }
      
      // Aşama 2 başlıyor
      progText.textContent = '250/2. aşama başlıyor...';
      progBar.style.width = '50%';
      
      const allUSDT = await getAllUSDTCoins();
      marketAnalysisCoins = allUSDT;
      const firstPhaseSymbols = new Set(scanPool.map(c => c.symbol));
      const remainingCoins = allUSDT.filter(c => !firstPhaseSymbols.has(c.symbol));
      
      if (remainingCoins.length > 0) {
        const bbData2 = await batchProcess(remainingCoins, allTFs, (coinDone, totalCoins, pct, totalTFs) => {
          const progress = 50 + (pct / 2);
          progBar.style.width = progress + '%';
          scanBtn.style.setProperty('--scan-progress', (progress / 100));
          progText.textContent = `250/2. aşama BB hesaplanıyor... (${coinDone} / ${totalCoins} coin)`;
        });
        
        const secondPhaseMatched = await Promise.all(remainingCoins.map(async coin => {
          const bbMatch = active.every(tf => {
            const s = bbData2[coin.symbol] && bbData2[coin.symbol][tf.id];
            return s !== null && s === tfStates[tf.id];
          });
          if (!bbMatch) return null;
          
          if (candleMode > 0) {
            const greenTFs = active.filter(tf => tfStates[tf.id] === STATE.GREEN);
            const redTFs = active.filter(tf => tfStates[tf.id] === STATE.RED);
            let bigGroup = [], smallGroup = [];
            if (greenTFs.length > redTFs.length) {
              bigGroup = greenTFs; smallGroup = redTFs;
            } else if (redTFs.length > greenTFs.length) {
              bigGroup = redTFs; smallGroup = greenTFs;
            } else {
              bigGroup = greenTFs; smallGroup = redTFs;
            }
            if (bigGroup.length <= smallGroup.length) return null;
            for (const tf of smallGroup) {
              const expectedColor = tfStates[tf.id] === STATE.GREEN ? 'green' : 'red';
              const candleOk = await checkLastNCandlesSameColor(coin.symbol, tf.id, candleMode, expectedColor);
              if (!candleOk) return null;
            }
          }
          
          const fresh = wsTickerData[coin.symbol];
          return {
            ...coin,
            change: fresh ? fresh.change : coin.change,
            volume: fresh ? fresh.volume : coin.volume,
            bbData: bbData2[coin.symbol],
          };
        }));
        
        const secondPhaseResults = secondPhaseMatched.filter(coin => coin !== null);
        
        if (secondPhaseResults.length > 0) {
          const allResults = [...scanResults, ...secondPhaseResults];
          scanResults = allResults;
          renderResults(allResults, active);
          
          if (trendLocked && active.length >= 2) {
            secondPhaseResults.forEach(coin => {
              const corr = calcCorrection(coin.symbol, bbData2);
              if (corr) correctionMap[coin.symbol] = corr;
            });
            updateCardSignals();
          }
        }
        
        const now2 = new Date();
        lastUpd.textContent = now2.toLocaleTimeString('tr-TR');
        
        progBar.style.width = '100%';
        progText.textContent = `Tarama tamamlandı. Toplam: ${allUSDT.length} coin`;
      }
      
      if (obInterval) { clearInterval(obInterval); obInterval = null; }
      prevSignals = {};
      runDeepAnalysis();
      obInterval = setInterval(runDeepAnalysis, 60000);
      
      connDot.className = 'online';
      connText.textContent = 'Bağlı';
    } else {
      if (obInterval) { clearInterval(obInterval); obInterval = null; }
      prevSignals = {};
      runDeepAnalysis();
      obInterval = setInterval(runDeepAnalysis, 60000);

      const now = new Date();
      lastUpd.textContent = now.toLocaleTimeString('tr-TR');

      connDot.className = 'online';
      connText.textContent = 'Bağlı';
    }

    // Genel piyasa analizi hesapla ve göster
    if (marketAnalysisCoins.length > 0) {
      const posCount = marketAnalysisCoins.filter(c => c.change > 0).length;
      const negCount = marketAnalysisCoins.filter(c => c.change < 0).length;
      const total = marketAnalysisCoins.length;
      const avgChange = marketAnalysisCoins.reduce((sum, c) => sum + c.change, 0) / total;
      const direction = posCount > negCount ? 'YUKARI' : negCount > posCount ? 'AŞAĞI' : 'YATAY';
      lastScanStats = { total, posCount, negCount, avgChange, direction };

      const panel = document.getElementById('detail-panel');
      if (panel) {
        const posPct = ((posCount / total) * 100).toFixed(1);
        const negPct = ((negCount / total) * 100).toFixed(1);
        const avgStr = (avgChange >= 0 ? '+' : '') + avgChange.toFixed(2) + '%';
        const dirColor = direction === 'YUKARI' ? '#00ff88' : direction === 'AŞAĞI' ? '#ff4d4d' : '#f0c040';
        panel.style.display = 'block';
        panel.style.background = '#050d1a';
        panel.style.borderColor = '#1e3a5f';
        panel.style.color = '#9ca3af';
        panel.innerHTML =
          '<div style="font-size:0.9rem;font-weight:700;color:#f0c040;margin-bottom:4px;">📊 Piyasa Genel Analizi</div>' +
          '<div style="font-size:0.8rem;line-height:1.6;">' +
          '<b>' + total + '</b> coin tarandı | <span style="color:#00ff88">' + posCount + ' yükselişte (' + posPct + '%)</span> — <span style="color:#ff4d4d">' + negCount + ' düşüşte (' + negPct + '%)</span><br>' +
          'Ortalama değişim: <b>' + avgStr + '</b> | Genel trend: <b style="color:' + dirColor + '">' + direction + '</b>' +
          '</div>';
      }
    }

    // Tarama tamamlandı, trend kilidi aktif değilse hatırlatma animasyonu başlat
    if (!trendLocked && scanResults.length > 0) {
      trendLockBtn.classList.add('pulse');
    }
  } catch (e) {
    showError('Hata: ' + e.message);
    connDot.className = 'offline';
    connText.textContent = 'Bağlantı Yok';
  } finally {
    scanBtn.disabled = false;
    scanBtn.textContent = 'Tara';
    scanBtn.classList.remove('scanning');
    progWrap.classList.remove('visible');
  }
}

/* ---- Render ---- */
function getSortedResults(results) {
  const sorted = [...results];
  const v = sortSelect.value;

  // Hacme g\u00f6re s\u0131ralama (TF'den ba\u011f\u0131ms\u0131z)
  if (v === 'volume') {
    sorted.sort((a, b) => {
      const va = typeof a.volume === 'number' && !isNaN(a.volume) ? a.volume : 0;
      const vb = typeof b.volume === 'number' && !isNaN(b.volume) ? b.volume : 0;
      return vb - va;
    });
    return sorted;
  }

  // Degisime g\u00f6re s\u0131ralama (YD/DY) i\u00e7in aktif TF'leri ve kullan\u0131lacak ana TF'yi belirle
  const active = getActiveTFs();
  let primaryTF = null;
  if (active.length === 1) {
    primaryTF = active[0];
  } else if (active.length > 1) {
    // Birden fazla TF a\u00e7\u0131ksa, mevcut davran\u0131\u015fa uygun olarak en b\u00fcy\u00fck TF'yi kullan
    primaryTF = active.slice().sort((a, b) => b.minutes - a.minutes)[0];
  }

  function getChangeValue(coin) {
    const sym = coin.symbol;
    // \u00d6nce se\u00e7ili/ana TF i\u00e7in hesaplanan % de\u011fi\u015fimi dene
    if (primaryTF && coinTFChanges[sym] && coinTFChanges[sym][primaryTF.id] != null) {
      const val = coinTFChanges[sym][primaryTF.id];
      if (typeof val === 'number' && !isNaN(val)) return val;
    }
    // Fallback: 24h de\u011fi\u015fim (coin.change)
    if (typeof coin.change === 'number' && !isNaN(coin.change)) {
      return coin.change;
    }
    // Hic veri yoksa null d\u00f6n (liste sonunda tutulacak)
    return null;
  }

  sorted.sort((a, b) => {
    const ca = getChangeValue(a);
    const cb = getChangeValue(b);

    // Veri olmayan coin'leri en alta it
    const aNull = (ca === null);
    const bNull = (cb === null);
    if (aNull && bNull) return 0;
    if (aNull) return 1;
    if (bNull) return -1;

    // YD: b\u00fcy\u00fckten k\u00fc\u00e7\u00fc\u011fe, DY: k\u00fc\u00e7\u00fckten b\u00fcy\u00fc\u011fe
    return v === 'change_desc' ? (cb - ca) : (ca - cb);
  });

  return sorted;
}

function buildCard(coin) {
  const card = document.createElement('div');
  const corr = correctionMap[coin.symbol];
  card.className = 'coin-card' + (corr ? ' ' + corr : '');
  card.dataset.symbol = coin.symbol;
  const activeTFs = getActiveTFs();
  let primaryTFForCard = null;
  if (activeTFs.length === 1) {
    primaryTFForCard = activeTFs[0];
  } else if (activeTFs.length > 1) {
    primaryTFForCard = activeTFs.slice().sort((a, b) => b.minutes - a.minutes)[0];
  }

  let displayChange = null;
  if (primaryTFForCard) {
    if (coinTFChanges[coin.symbol] && coinTFChanges[coin.symbol][primaryTFForCard.id] != null) {
      const v = coinTFChanges[coin.symbol][primaryTFForCard.id];
      if (typeof v === 'number' && !isNaN(v)) displayChange = v;
    }
  } else {
    // Hiç TF aktif değilse kartta 24h değişimi göster
    if (typeof coin.change === 'number' && !isNaN(coin.change)) {
      displayChange = coin.change;
    }
  }

  const posNeg    = displayChange !== null ? displayChange >= 0 : false;
  const changeStr = displayChange === null ? '\u2014' : (posNeg ? '+' : '') + displayChange.toFixed(2) + '%';
  const isNew     = newSymbols.has(coin.symbol);
  const base      = coin.symbol.replace('USDT', '');
  const hasAlarm  = alarms.some(a => a.symbol === coin.symbol && !a.triggered);
  const ind = coinIndicators[coin.symbol];
  const ls  = coinLSData[coin.symbol];
  const fr  = coinFRData[coin.symbol];
  const frVal   = fr ? (fr.fundingRate * 100).toFixed(4) + '%' : '\u2014';
  const frColor = fr ? (fr.fundingRate < 0 ? '#00ff88' : fr.fundingRate > 0.0005 ? '#ff2266' : '#aaa') : '#aaa';
  const oiVal   = fr ? (fr.oiChange >= 0 ? '+' : '') + fr.oiChange.toFixed(2) + '%' : '\u2014';
  const oiColor = fr ? (fr.oiChange > 0.3 ? '#00ff88' : fr.oiChange < -0.5 ? '#ff2266' : '#aaa') : '#aaa';

  // Mum badge: sadece mum butonu aktifse ve coin'in max mum zinciri varsa
  let streakHtml = '';
  const streak = coinCandleStreaks[coin.symbol];
  if (candleMode === 1 && streak && streak.count >= 2) {
    const badgeClass = streak.direction === 'green' ? 'up' : 'down';
    streakHtml = `<span class="candle-badge ${badgeClass}">${streak.count}</span>`;
  }

  // BB %B badge: en büyük aktif TF'nin band pozisyonu
  let pctBHtml = '';
  const bigTF = getLargestActiveTF();
  if (bigTF) {
    const pctB = getBBPctB(coin.symbol, bigTF.id);
    if (pctB !== null) {
      const val = Math.round(pctB);
      let cls = 'neutral', icon = '';
      if (val >= 80) { cls = 'risk'; icon = '⚠️'; }
      else if (val <= 20) { cls = 'opportunity'; icon = '✦'; }
      pctBHtml = `<span class="bb-pct-badge ${cls}">BB:${val}${icon}</span>`;
    }
  }

  card.innerHTML = `
    <div class="coin-card-top">
      <span class="coin-sym${isNew ? ' new-listing' : ''}">${base}<span class="usdt-text">USDT</span>${isNew ? '<span class="new-badge">YEN\u0130</span>' : ''}</span>
      <span class="coin-change ${posNeg ? 'pos' : 'neg'}">${changeStr}</span>
    </div>
    <div class="card-row">
      <span class="row-label">FR: <span class="fr-val" style="color:${frColor}">${frVal}</span></span>
      ${pctBHtml}
    </div>
    <div class="card-row">
      <span class="row-label">OI: <span class="oi-val" style="color:${oiColor}">${oiVal}</span></span>
      <span class="row-right">
        ${streakHtml}
        <button class="btn-detail-sm">Detay</button>
      </span>
    </div>
  `;
  return card;
}

function renderResults(results, activeTFs, forceFull) {
  const sorted = getSortedResults(results);
  const doFull = forceFull || forceNextFullRender || resultsGrid.children.length === 0;
  forceNextFullRender = false;

  if (!sorted.length) {
    noResults.classList.add('visible');
    resultsCnt.innerHTML = 'Sonu\u00E7: <span>0</span> coin e\u015Fle\u015Fti';
    if (doFull) resultsGrid.innerHTML = '';
    return;
  }

  noResults.classList.remove('visible');
  const totalLabel = trendLocked ? `${lockedCoins.length} coin (kilitli)` : `${top120.length} tarand\u0131`;
  resultsCnt.innerHTML = `Sonu\u00E7: <span>${sorted.length}</span> coin e\u015Fle\u015Fti (${totalLabel})`;

  if (doFull) {
    resultsGrid.innerHTML = '';
    sorted.forEach(coin => resultsGrid.appendChild(buildCard(coin)));
    return;
  }

  // ---- Artimli guncelleme ----
  const cardMap = new Map();
  resultsGrid.querySelectorAll('.coin-card').forEach(c => cardMap.set(c.dataset.symbol, c));

  const newSet = new Set(sorted.map(c => c.symbol));

  // Filtreye uymayan kartlari kaldir
  cardMap.forEach((card, sym) => {
    if (!newSet.has(sym)) { card.remove(); cardMap.delete(sym); }
  });

  // Yeni coinler icin kart olustur
  sorted.forEach(coin => {
    if (!cardMap.has(coin.symbol)) {
      const card = buildCard(coin);
      resultsGrid.appendChild(card);
      cardMap.set(coin.symbol, card);
    }
  });

  // Siraya gore DOM'da yeniden diz (appendChild tasiyor, silmiyor)
  sorted.forEach(coin => resultsGrid.appendChild(cardMap.get(coin.symbol)));
}

function updateCardSignals() {
  document.querySelectorAll('.coin-card').forEach(card => {
    const sym = card.dataset.symbol;
    if (!sym) return;
    // Düzeltme class güncellemesi
    card.classList.remove('pullback', 'bounce');
    const corr = correctionMap[sym];
    if (corr) card.classList.add(corr);
    const ind = coinIndicators[sym];
    const ls  = coinLSData[sym];
    const fr  = coinFRData[sym];
    const sig = calcCompositeSignal(ind, ls, fr);

    const frColor = fr ? (fr.fundingRate < 0 ? '#00ff88' : fr.fundingRate > 0.0005 ? '#ff2266' : '#aaa') : '#aaa';
    const oiColor = fr ? (fr.oiChange > 0.3 ? '#00ff88' : fr.oiChange < -0.5 ? '#ff2266' : '#aaa') : '#aaa';
    const frVal   = fr ? (fr.fundingRate * 100).toFixed(4) + '%' : '\u2014';
    const oiVal   = fr ? (fr.oiChange >= 0 ? '+' : '') + fr.oiChange.toFixed(2) + '%' : '\u2014';

    const frSpan = card.querySelector('.fr-val');
    const oiSpan = card.querySelector('.oi-val');
    if (frSpan) { frSpan.style.color = frColor; frSpan.textContent = frVal; }
    if (oiSpan) { oiSpan.style.color = oiColor; oiSpan.textContent = oiVal; }

    // BB %B badge güncelle
    const bigTF2 = getLargestActiveTF();
    if (bigTF2) {
      const pctB2 = getBBPctB(sym, bigTF2.id);
      const bbBadge = card.querySelector('.bb-pct-badge');
      if (bbBadge && pctB2 !== null) {
        const val = Math.round(pctB2);
        let cls = 'neutral', icon = '';
        if (val >= 80) { cls = 'risk'; icon = '⚠️'; }
        else if (val <= 20) { cls = 'opportunity'; icon = '✦'; }
        bbBadge.className = `bb-pct-badge ${cls}`;
        bbBadge.textContent = `BB:${val}${icon}`;
      }
    }

    // Update detail panel if it's showing this coin
    const panel = document.getElementById('detail-panel');
    if (panel && panel.style.display === 'block' && lastDetailSym === sym) {
      showCoinPopup(sym);
    }
  });
}

/* ---- Coin Detail Panel ---- */
function showCoinPopup(symbol) {
  try {
    var panel = document.getElementById('detail-panel');
    if (!panel) return;
    panel.style.display = 'block';
    lastDetailSym = symbol;

    var ind = coinIndicators[symbol];
    var ls  = coinLSData[symbol];
    var fr  = coinFRData[symbol];

    var frPct   = fr ? (fr.fundingRate * 100).toFixed(4) + '%' : '\u2014';
    var frColor = fr ? (fr.fundingRate < 0 ? '#00ff88' : fr.fundingRate > 0.0005 ? '#ff4d4d' : '#aaa') : '#aaa';
    var oiPct   = fr ? (fr.oiChange >= 0 ? '+' : '') + fr.oiChange.toFixed(2) + '%' : '\u2014';
    var oiColor = fr ? (fr.oiChange > 0.3 ? '#00ff88' : fr.oiChange < -0.3 ? '#ff4d4d' : '#aaa') : '#aaa';

    var frYorum, oiYorum;
    if (!fr) {
      frYorum = '\u2014'; oiYorum = '\u2014';
    } else {
      if (fr.fundingRate < -0.0005)
        frYorum = 'Short Squeeze: Sat\u0131\u015fc\u0131lar fazla \u2014 pozisyon kapat\u0131rken y\u00fckseli\u015fle zarar eder \u2192 yükseli\u015f potansiyeli';
      else if (fr.fundingRate < -0.0002)
        frYorum = 'Short Bask\u0131s\u0131: Sat\u0131\u015fc\u0131 a\u011f\u0131rl\u0131kl\u0131 \u2014 yukar\u0131 y\u00f6nl\u00fc hareket g\u00fc\u00e7lenebilir';
      else if (fr.fundingRate > 0.001)
        frYorum = 'Long Squeeze: Al\u0131c\u0131lar fazla \u2014 pozisyon kapat\u0131rken zarar eder \u2192 d\u00fc\u015f\u00f6 potansiyeli';
      else if (fr.fundingRate > 0.0005)
        frYorum = 'Long Bask\u0131s\u0131: Al\u0131c\u0131 a\u011f\u0131rl\u0131kl\u0131 \u2014 a\u015fa\u011f\u0131 y\u00f6nl\u00fc bask\u0131 olu\u015fabilir';
      else
        frYorum = 'Dengeli \u2014 belirgin bir bask\u0131 yok';

      if (fr.oiChange > 1)
        oiYorum = fr.fundingRate >= 0
          ? 'Al\u0131\u015f pozisyonlar\u0131 h\u0131zla art\u0131yor \u2014 yukar\u0131 hareketi g\u00fc\u00e7lenebilir'
          : 'Sat\u0131\u015f pozisyonlar\u0131 h\u0131zla art\u0131yor \u2014 a\u015fa\u011f\u0131 hareketi g\u00fc\u00e7lenebilir';
      else if (fr.oiChange > 0.3)
        oiYorum = fr.fundingRate >= 0
          ? 'Piyasaya al\u0131\u015f paras\u0131 giriyor \u2014 i\u015flem hacmi art\u0131yor'
          : 'Piyasaya sat\u0131\u015f paras\u0131 giriyor \u2014 i\u015flem hacmi art\u0131yor';
      else if (fr.oiChange < -0.5)
        oiYorum = fr.fundingRate >= 0
          ? 'Al\u0131\u015f pozisyonlar\u0131 h\u0131zla kapan\u0131yor \u2014 yukar\u0131 hareketi yava\u015flayabilir'
          : 'Sat\u0131\u015f pozisyonlar\u0131 h\u0131zla kapan\u0131yor \u2014 a\u015fa\u011f\u0131 hareketi yava\u015flayabilir';
      else if (fr.oiChange < -0.3)
        oiYorum = fr.fundingRate >= 0
          ? 'Al\u0131\u015f pozisyonlar\u0131 kapan\u0131yor \u2014 sat\u0131\u015f bask\u0131s\u0131 artabilir'
          : 'Sat\u0131\u015f pozisyonlar\u0131 kapan\u0131yor \u2014 yukar\u0131 y\u00f6nl\u00fc toparlanma olabilir';
      else
        oiYorum = 'Sakin \u2014 b\u00fcy\u00fck bir hareket beklentisi yok';
    }

    var rsiNum   = (ind && ind.rsi !== null) ? ind.rsi : null;
    var rsi      = rsiNum !== null ? Number(rsiNum).toFixed(1) : '\u2014';
    var rsiColor = rsiNum !== null ? (rsiNum < 30 ? '#00ff88' : rsiNum > 70 ? '#ff4d4d' : '#aaa') : '#aaa';
    var lsVal    = ls ? ls.accRatio : '\u2014';
    var lsColor  = ls ? (ls.signal === 'bullish' ? '#00ff88' : ls.signal === 'bearish' ? '#ff4d4d' : '#aaa') : '#aaa';

    // BB %B değeri
    var bigTF = getLargestActiveTF();
    var bbPctB = bigTF ? getBBPctB(symbol, bigTF.id) : null;
    var bbVal = bbPctB !== null ? Math.round(bbPctB) : '\u2014';
    var bbColor = (bbPctB !== null) ? (bbVal >= 80 ? '#ff4d4d' : bbVal <= 20 ? '#00ff88' : '#f0c040') : '#aaa';
    var bbLabel = (bbPctB !== null) ? (bbVal >= 80 ? ' \u26a0\ufe0f Short' : bbVal <= 20 ? ' \u2726 Long' : '') : '';

    var composite = calcCompositeSignal(ind, ls, fr);
    var comment = '';
    var commentColor = '#9ca3af', commentBg = '#050d1a', borderColor = '#1e3a5f';

    // Coin'in kendi değişimi ve piyasa karşılaştırması
    var coinChange = (wsTickerData[symbol] && wsTickerData[symbol].change !== undefined)
      ? wsTickerData[symbol].change
      : null;
    var coinChangeStr = coinChange !== null ? ((coinChange >= 0 ? '+' : '') + coinChange.toFixed(2) + '%') : '\u2014';
    var coinChangeColor = coinChange !== null ? (coinChange >= 0 ? '#00ff88' : '#ff4d4d') : '#aaa';
    var marketCompare = '';
    if (lastScanStats && coinChange !== null) {
      var diff = coinChange - lastScanStats.avgChange;
      var diffStr = (diff >= 0 ? '+' : '') + diff.toFixed(2) + '%';
      var diffColor = diff >= 0 ? '#00ff88' : '#ff4d4d';
      marketCompare = 'Piyasa ortalamasından: <span style="color:' + diffColor + '">' + diffStr + '</span>';
    }

    if (composite === 'bullish') {
      commentColor = '#6ee7b7'; commentBg = '#052e16'; borderColor = '#00ff88';
      comment = fr && fr.fundingRate < -0.0003
        ? '\u2b06 Short squeeze riski y\u00fcksek. FR negatif + OI art\u0131yor.'
        : '\u2b06 Y\u00fckseli\u015f y\u00f6nl\u00fc sinyal — g\u00fc\u00e7l\u00fc al\u0131\u015f bask\u0131s\u0131.';
    } else if (composite === 'bearish') {
      commentColor = '#fca5a5'; commentBg = '#2d0a14'; borderColor = '#ff4d4d';
      comment = fr && fr.oiChange < -0.3
        ? '\u2b07 Pozisyonlar h\u0131zla kapan\u0131yor. D\u00fc\u015f\u00fc\u015f ivmesi devam edebilir.'
        : '\u2b07 D\u00fc\u015f\u00fc\u015f y\u00f6nl\u00fc sinyal — sat\u0131\u015f bask\u0131s\u0131 art\u0131yor.';
    } else {
      comment = 'Tarafs\u0131z — net bir y\u00f6n sinyali yok. K\u0131sa vadede yatay hareket bekleniyor.';
    }

    panel.style.background  = commentBg;
    panel.style.borderColor = borderColor;
    panel.style.color       = commentColor;
    panel.innerHTML =
      '<button onclick="this.parentElement.style.display=\'none\'; lastDetailSym = null;" style="position:absolute;top:8px;right:8px;background:none;border:none;color:#888;font-size:1.2rem;cursor:pointer;padding:4px;line-height:1;">×</button>' +
      '<b style="font-size:0.92rem;color:#f0c040">' + symbol.replace('USDT','') + '/USDT</b>' +
      ' &nbsp;|&nbsp; BB: <span style="color:' + bbColor + '">' + bbVal + bbLabel + '</span>' +
      ' &nbsp;|&nbsp; 24S: <span style="color:' + coinChangeColor + '">' + coinChangeStr + '</span>' +
      ' &nbsp;|&nbsp; FR: <span style="color:' + frColor + '">' + frPct + '</span> <small style="color:#666">(' + frYorum + ')</small>' +
      ' &nbsp;|&nbsp; OI: <span style="color:' + oiColor + '">' + oiPct + '</span> <small style="color:#666">(' + oiYorum + ')</small>' +
      ' &nbsp;|&nbsp; RSI: <span style="color:' + rsiColor + '">' + rsi + '</span>' +
      ' &nbsp;|&nbsp; L/S: <span style="color:' + lsColor + '">' + lsVal + '</span>' +
      (marketCompare ? '<br><span style="font-size:0.75rem;color:#888;">' + marketCompare + '</span>' : '') +
      '<br><span style="font-size:0.8rem;margin-top:6px;display:block">' + comment + '</span>';
  } catch(err) {
    console.error('showCoinPopup error:', err);
    var panel = document.getElementById('detail-panel');
    if (panel) panel.innerHTML = '<b style="color:#f0c040">' + symbol.replace('USDT','') + '/USDT</b> &nbsp;<small style="color:#ff4d4d">veri al\u0131namad\u0131.</small>';
  }
}

/* ---- Alarm Modal ---- */
function openAlarmModal(symbol) {
  modalSymbol = symbol;
  modalDir = 0;
  modalCoinLbl.textContent = symbol.replace('USDT', '') + ' / USDT icin alarm';
  document.querySelectorAll('.dir-btn').forEach(b => b.classList.remove('selected'));
  modalOverlay.style.display = '';
  modalOverlay.classList.add('visible');
}

document.querySelectorAll('.dir-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.dir-btn').forEach(b => b.classList.remove('selected'));
    btn.classList.add('selected');
    modalDir = parseInt(btn.dataset.dir);
  });
});

modalCancelBtn.addEventListener('click', () => { modalOverlay.classList.remove('visible'); modalOverlay.style.display = 'none'; });
modalOverlay.addEventListener('click', e => {
  if (e.target === modalOverlay) {
    modalOverlay.classList.remove('visible');
    modalOverlay.style.display = 'none';
  }
});

modalSaveBtn.addEventListener('click', () => {
  if (!modalDir) { alert('Lutfen bir yon secin.'); return; }
  if (alarms.length >= 20) { alert('Maksimum 20 alarm kurabilirsiniz. Lütfen önce bir alarm silin.'); return; }
  const tfId = modalTfSel.value;
  const existing = alarms.findIndex(a => a.symbol === modalSymbol && a.tfId === tfId && a.dir === modalDir);
  if (existing === -1) {
    alarms.push({ id: Date.now(), symbol: modalSymbol, dir: modalDir, tfId, triggered: false });
    saveAlarms();
    renderAlarmsPanel();
  }
  modalOverlay.classList.remove('visible');
  modalOverlay.style.display = '';
  if (window.openAlarmsOverlay) window.openAlarmsOverlay();
});

function saveAlarms() {
  localStorage.setItem('bf_alarms', JSON.stringify(alarms));
}

function renderAlarmsPanel() { /* inline panel kaldırıldı - popup kullanılıyor */ }

/* ---- Alarm check during scan ---- */
function checkAlarms(bbData, allCoins) {
  const triggered = [];
  alarms.forEach(alarm => {
    if (alarm.triggered) return;
    const coinBB = bbData[alarm.symbol];
    if (!coinBB) return;
    const state = coinBB[alarm.tfId];
    if (state !== null && state !== undefined && state === alarm.dir) {
      alarm.triggered = true;
      triggered.push(alarm);
      showNotification(alarm);
    }
  });
  if (triggered.length) {
    triggered.forEach(a => playAlarmSound(a.dir));
    saveAlarms();
  }
}

/* ---- Audio alarm ---- */
function playAlarmSound(dir) {
  if (!window.alarmSoundEnabled) return;
  try {
    var b64 = dir === STATE.GREEN ? YUKSELIS_B64 : DUSUS_B64;
    var audio = new Audio('data:audio/mp3;base64,' + b64);
    audio.volume = 1.0;
    audio.play();
  } catch(e) {}
}

/* ---- Alarm Listesi Popup ---- */

/* ---- Notifications ---- */
function showNotification(alarm) {
  try {
    var tf   = TIMEFRAMES.find(function(t){ return t.id === alarm.tfId; });
    var cls  = alarm.dir === STATE.GREEN ? 'green' : 'red';
    var dir  = alarm.dir === STATE.GREEN ? '&#9650; YÜKSELİŞ' : '&#9660; DÜŞÜŞ';
    var now  = new Date();
    var saat = now.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit', second: '2-digit' });

    var card = document.createElement('div');
    card.className = 'notif-card ' + cls;
    card.innerHTML =
      '<button class="notif-close" title="Kapat">&#x2715;</button>' +
      '<div class="notif-sym">' + alarm.symbol.replace('USDT', '/USDT') + '</div>' +
      '<div class="notif-dir">' + dir + ' &bull; ' + (tf ? tf.label : alarm.tfId) + '</div>' +
      '<div class="notif-time">&#128336; ' + saat + '</div>';

    card.querySelector('.notif-close').addEventListener('click', function() { card.remove(); });

    var notifEl = document.getElementById('alarm-notif');
    if (notifEl) notifEl.appendChild(card);
  } catch(e) {}
}

/* ---- Controls ---- */
function showError(msg) { errBox.textContent = msg; errBox.classList.add('visible'); }
function hideError()    { errBox.classList.remove('visible'); }

clearBtn.addEventListener('click', () => {
  correctionMap = {};
  TIMEFRAMES.forEach(tf => {
    tfStates[tf.id] = STATE.EMPTY;
    document.getElementById('btn-' + tf.id).className = 'tf-btn';
  });
  resultsGrid.innerHTML = '';
  noResults.classList.remove('visible');
  resultsCnt.innerHTML = '';
  lastUpd.textContent = '';
  hideError();
  coinTFChanges = {};
  top120 = [];
  scanResults = [];
  trendLocked = false;
  lockedCoins = [];
  trendLockBtn.classList.remove('active');
  trendLockBtn.textContent = 'Trend';
  trendLockBadge.classList.remove('visible');
  candleMode = 0; candleBtn.textContent = 'Mum'; candleBtn.className = '';
  coinCandleStreaks = {};
  if (obInterval) { clearInterval(obInterval); obInterval = null; }
  coinIndicators = {};
  coinLSData = {};
  coinFRData = {};
  forceNextFullRender = true;
  selectedCard = null; // Seçili kartı temizle
  lastDetailSym = null;
  var dp = document.getElementById('detail-panel');
  if (dp) { dp.style.display = 'none'; dp.innerHTML = ''; }
});

scanBtn.addEventListener('click', runScan);

let lastDetailSym = null;
let selectedCard = null;

resultsGrid.addEventListener('click', function(e) {
    var detailBtn = e.target.closest('.btn-detail-sm');
    if (detailBtn) {
      var card = detailBtn.closest('.coin-card');
      if (card && card.dataset.symbol) {
        // Kart seçimi
        if (selectedCard) selectedCard.classList.remove('selected');
        card.classList.add('selected');
        selectedCard = card;
        
        var sym = card.dataset.symbol;
        var panel = document.getElementById('detail-panel');

        // Toggle: same coin = hide, different coin = show
        if (panel && panel.style.display === 'block' && lastDetailSym === sym) {
          panel.style.display = 'none';
          lastDetailSym = null;
          return;
        }

        lastDetailSym = sym;
        if (panel) {
          panel.style.display = 'block';
          panel.style.background = '#050d1a';
          panel.style.borderColor = '#f0b90b';
          panel.style.color = '#888';
          panel.innerHTML = '<span style="color:#888">Y\u00fckleniyor...</span>';
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }
        fetchFundingOI(sym).then(function(fr) {
          if (sym !== lastDetailSym) return;
          if (fr) coinFRData[sym] = fr;
          showCoinPopup(sym);
          if (panel) setTimeout(function(){ panel.style.borderColor = '#1e3a5f'; }, 400);
        }).catch(function() {
          showCoinPopup(sym);
        });
      }
      return;
    }
    var alarmBtn = e.target.closest('.alarm-btn');
  if (alarmBtn) {
    e.stopPropagation();
    var card = alarmBtn.closest('.coin-card');
    if (card && card.dataset.symbol) {
      // Kart seçimi
      if (selectedCard) selectedCard.classList.remove('selected');
      card.classList.add('selected');
      selectedCard = card;
      openAlarmModal(card.dataset.symbol);
    }
    return;
  }
  var coinSym = e.target.closest('.coin-sym');
  if (coinSym) {
    e.stopPropagation();
    var card = coinSym.closest('.coin-card');
    if (card && card.dataset.symbol) {
      // Kart seçimi
      if (selectedCard) selectedCard.classList.remove('selected');
      card.classList.add('selected');
      selectedCard = card;
      openAlarmModal(card.dataset.symbol);
    }
    return;
  }
  
  // Kartın herhangi bir yerine tıklandığında seç
  var clickedCard = e.target.closest('.coin-card');
  if (clickedCard && clickedCard.dataset.symbol) {
    // Detay butonu, alarm butonu veya sembol butonu değilse direkt seç
    if (!detailBtn && !alarmBtn && !coinSym) {
      if (selectedCard) selectedCard.classList.remove('selected');
      clickedCard.classList.add('selected');
      selectedCard = clickedCard;
    }
  }
});

sortSelect.addEventListener('change', () => {
  if (scanResults.length) renderResults(scanResults, getActiveTFs());
});

/* ---- Auto scan with countdown ---- */
function startAutoScan() {
  stopAutoScan();
  const interval = parseInt(autoScanInterval.value) || 60;
  countdownSec = interval;
  cdText.textContent = `${countdownSec}s`;
  countdownInterval = setInterval(() => {
    countdownSec--;
    if (countdownSec <= 0) {
      countdownSec = interval;
      runScan();
    }
    cdText.textContent = `${countdownSec}s`;
  }, 1000);
}

function stopAutoScan() {
  if (countdownInterval) { clearInterval(countdownInterval); countdownInterval = null; }
  cdText.textContent = '';
}

autoScanCb.addEventListener('change', () => {
  if (autoScanCb.checked) startAutoScan();
  else stopAutoScan();
});

autoScanInterval.addEventListener('change', () => {
  if (autoScanCb.checked) {
    stopAutoScan();
    startAutoScan();
  }
});

/* ---- BTC Status ---- */
async function updateBTCStatus() {
  try {
    // Direkt API'den BTC verisi çek
    const url = `${BASE}/fapi/v1/ticker/24hr?symbol=BTCUSDT`;
    const r = await fetchWithRetry(url);
    const data = await r.json();
    
    const price = parseFloat(data.lastPrice);
    const change = parseFloat(data.priceChangePercent);
    const posNeg = change >= 0;
    const changeStr = !isNaN(change) ? (posNeg ? '+' : '') + change.toFixed(2) + '%' : '\u2014';
    const priceStr = !isNaN(price) ? Number(price).toLocaleString('en-US', {maximumFractionDigits: 0}) : '\u2014';

    let tfHtml = '';
    for (const tf of TIMEFRAMES) {
      const state = await fetchBBState('BTCUSDT', tf.id);
      if (state === STATE.GREEN) tfHtml += `<span class="btc-tf green">${tf.label}</span>`;
      else if (state === STATE.RED) tfHtml += `<span class="btc-tf red">${tf.label}</span>`;
      else tfHtml += `<span class="btc-tf gray">${tf.label}</span>`;
    }

    btcStatusEl.innerHTML = `<span class="btc-label">BTC</span><span class="btc-price">$${priceStr}</span><span class="btc-change ${posNeg ? 'pos' : 'neg'}">${changeStr}</span>${tfHtml}`;
    btcStatusEl.classList.add('visible');
  } catch (e) {
    // Hata durumunda boş göster
    btcStatusEl.innerHTML = `<span class="btc-label">BTC</span><span class="btc-price">\u2014</span><span class="btc-change">\u2014</span>`;
    btcStatusEl.classList.add('visible');
  }
}

/* ---- Init ---- */
buildTFButtons();
buildModalTFSelect();
// Varsayılan olarak auto-scan kapalı
if (autoScanCb.checked) startAutoScan();
connectTickerWS();
setTimeout(updateBTCStatus, 3000);
setInterval(updateBTCStatus, 60000);

/* ---- Alarm Listesi Popup ---- */
(function() {
  var overlay     = document.getElementById('alarms-overlay');
  var overlayList = document.getElementById('alarms-overlay-list');
  var addBtn      = document.getElementById('alarms-add-btn');
  var closeBtn    = document.getElementById('alarms-overlay-close');
  var clearBtn    = document.getElementById('alarms-clear-btn');
  var soundBtn    = document.getElementById('alarms-sound-btn');
  var listBtn     = document.getElementById('alarm-list-btn');

  /* Ses durumu */
  window.alarmSoundEnabled = localStorage.getItem('alarm_sound') !== 'off';
  function updateSoundBtn() {
    if (window.alarmSoundEnabled) {
      soundBtn.textContent = '\uD83D\uDD14 Ses Açık';
      soundBtn.style.color = '#00d4ff';
    } else {
      soundBtn.textContent = '\uD83D\uDD07 Ses Kapalı';
      soundBtn.style.color = '#888';
    }
  }
  updateSoundBtn();

  if (soundBtn) soundBtn.addEventListener('click', function() {
    window.alarmSoundEnabled = !window.alarmSoundEnabled;
    localStorage.setItem('alarm_sound', window.alarmSoundEnabled ? 'on' : 'off');
    updateSoundBtn();
  });

  if (clearBtn) clearBtn.addEventListener('click', function() {
    if (!alarms.length) return;
    if (!confirm('Tüm alarmlar silinsin mi?')) return;
    alarms = [];
    saveAlarms();
    updateAlarmBadges();
    renderAlarmOverlay();
  });

  function renderAlarmOverlay() {
    if (!overlayList) return;
    if (!alarms.length) {
      overlayList.innerHTML = '<div style="color:#555;font-size:0.82rem;text-align:center;padding:20px 0;">Henüz alarm kurulmamış.</div>';
      return;
    }
    overlayList.innerHTML = alarms.map(function(a, i) {
      var tf  = TIMEFRAMES.find(function(t){ return t.id === a.tfId; });
      var dir = a.dir === STATE.GREEN ? '\u2B06 Yükseliş' : '\u2B07 Düşüş';
      var dirColor = a.dir === STATE.GREEN ? '#00ff88' : '#ff2266';
      var status = a.triggered
        ? '<span style="color:#f0c040;font-size:0.7rem;">&#9654; Tetiklendi</span>'
        : '<span style="color:#00ff88;font-size:0.7rem;">&#9679; Aktif</span>';
      var rowOpacity = a.triggered ? 'opacity:0.5;' : '';
      var resetBtn = a.triggered
        ? '<button data-alarm-idx="' + i + '" class="alarm-reset-btn" style="background:none;border:1px solid #1a3a1a;color:#00ff88;border-radius:5px;padding:3px 8px;font-size:0.72rem;cursor:pointer;">Aktif Et</button>'
        : '';
      return '<div style="display:flex;align-items:center;justify-content:space-between;padding:8px 0;border-bottom:1px solid #1a2744;' + rowOpacity + '">' +
        '<div style="font-size:0.8rem;">' +
          '<b style="color:#f0c040;">' + a.symbol.replace('USDT','') + '/USDT</b>' +
          ' <span style="color:' + dirColor + ';font-size:0.75rem;">' + dir + '</span>' +
          ' <span style="color:#888;font-size:0.72rem;">' + (tf ? tf.label : a.tfId) + '</span>' +
          '<br>' + status +
        '</div>' +
        '<div style="display:flex;gap:4px;">' +
          resetBtn +
          '<button data-alarm-idx="' + i + '" class="alarm-del-btn" style="background:none;border:1px solid #3a1a1a;color:#ff4444;border-radius:5px;padding:3px 8px;font-size:0.72rem;cursor:pointer;">Sil</button>' +
        '</div>' +
      '</div>';
    }).join('');
    overlayList.querySelectorAll('.alarm-del-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = parseInt(btn.dataset.alarmIdx);
        alarms.splice(idx, 1);
        saveAlarms();
        updateAlarmBadges();
        renderAlarmOverlay();
      });
    });
    overlayList.querySelectorAll('.alarm-reset-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var idx = parseInt(btn.dataset.alarmIdx);
        alarms[idx].triggered = false;
        saveAlarms();
        renderAlarmOverlay();
      });
    });
  }

  function openOverlay() {
    renderAlarmOverlay();
    overlay.style.display = 'flex';
  }

  if (listBtn) listBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    openOverlay();
  });

  if (closeBtn) closeBtn.addEventListener('click', function() {
    overlay.style.display = 'none';
  });

  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) overlay.style.display = 'none';
  });

  if (addBtn) addBtn.addEventListener('click', function() {
    overlay.style.display = 'none';
    alert('Alarm kurmak için listeden bir coinin "Alarm" butonuna tıklayın.');
  });

  // Kart alarm butonu → popup ac
  resultsGrid.addEventListener('click', function(e) {}, false); // event delegation zaten asagida

  // Global erişim icin
  window.openAlarmsOverlay = openOverlay;
})();

/* ---- FR/OI Info Popup ---- */
(function() {
  var froiBtn = document.getElementById('froi-info-btn');
  var froiOverlay = document.getElementById('froi-overlay');
  if (froiBtn && froiOverlay) {
    froiBtn.addEventListener('click', function(e) {
      e.stopPropagation();
      froiOverlay.style.display = 'flex';
    });
    froiOverlay.addEventListener('click', function(e) {
      if (e.target === froiOverlay) froiOverlay.style.display = 'none';
    });
  }
})();

/* ---- PWA Service Worker ---- */
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js').then(function(reg) {
    console.log('SW registered');

    // Bildirim izni iste
    if ('Notification' in window && Notification.permission === 'default') {
      Notification.requestPermission();
    }
  }).catch(function(err) {
    console.log('SW registration failed:', err);
  });
}

// Alarm degistiginde SW'ye cache uzerinden bildir
function syncAlarmsToSW() {
  if (!('caches' in window)) return;
  var activeAlarms = alarms.filter(function(a) { return !a.triggered; });
  caches.open('bf-cache-v1').then(function(cache) {
    var resp = new Response(JSON.stringify({ alarms: alarms }));
    cache.put('bf-alarms-data', resp);
  });

  // SW'ye mesaj gonder: alarm varsa basla, yoksa durdur
  if (navigator.serviceWorker && navigator.serviceWorker.controller) {
    if (activeAlarms.length > 0) {
      navigator.serviceWorker.controller.postMessage({ type: 'START_ALARM_CHECK' });
    } else {
      navigator.serviceWorker.controller.postMessage({ type: 'STOP_ALARM_CHECK' });
    }
  }
}

// Mevcut saveAlarms fonksiyonunu wrap et
var _origSaveAlarms = saveAlarms;
saveAlarms = function() {
  _origSaveAlarms();
  syncAlarmsToSW();
};

// Sayfa yuklendiginde mevcut alarmlari SW'ye gonder
setTimeout(syncAlarmsToSW, 3000);

/* ---- NOVA AI Chat Panel ---- */
(function() {
  const novaPanel = document.getElementById('nova-panel');
  const novaBtn = document.getElementById('nova-btn');
  const novaClose = document.getElementById('nova-close');
  const novaInput = document.getElementById('nova-input');
  const novaSend = document.getElementById('nova-send');
  const novaMessages = document.getElementById('nova-messages');
  const tabGemini = document.getElementById('nova-tab-gemini');
  const tabGroq = document.getElementById('nova-tab-groq');
  
  let currentModel = 'groq';
  
  // Mobil tam ekran elemanları
  const novaFull = document.getElementById('nova-fullscreen');
  const novaFullBack = document.getElementById('nova-full-back');
  const novaFullInput = document.getElementById('nova-full-input');
  const novaFullSend = document.getElementById('nova-full-send');
  const novaFullMessages = document.getElementById('nova-full-messages');
  const tabFullGemini = document.getElementById('nova-full-tab-gemini');
  const tabFullGroq = document.getElementById('nova-full-tab-groq');
  
  // Ekran genişliğine göre panel seçimi
  function isMobile() {
    return window.innerWidth <= 768;
  }
  
  // Panel aç/kapa
  if (novaBtn) {
    novaBtn.addEventListener('click', () => {
      if (isMobile()) {
        novaFull.style.display = 'flex';
        bindFullScreenEvents();
        const input = document.getElementById('nova-full-input');
        if (input) input.focus();
      } else {
        const isVisible = novaPanel.style.display === 'flex';
        novaPanel.style.display = isVisible ? 'none' : 'flex';
        if (!isVisible) {
          bindPanelEvents();
          const input = document.getElementById('nova-input');
          if (input) input.focus();
        }
      }
    });
  }
  
  if (novaClose) {
    novaClose.addEventListener('click', () => {
      novaPanel.style.display = 'none';
    });
  }
  
  if (novaFullBack) {
    novaFullBack.addEventListener('click', () => {
      novaFull.style.display = 'none';
    });
  }
  
  // Event binding fonksiyonları
  let panelEventsBound = false;
  let fullScreenEventsBound = false;
  
  function bindPanelEvents() {
    if (panelEventsBound) return;
    const input = document.getElementById('nova-input');
    const send = document.getElementById('nova-send');
    if (send && input) {
      send.onclick = sendMessage;
      input.onkeypress = (e) => { if (e.key === 'Enter') sendMessage(); };
      panelEventsBound = true;
    }
  }
  
  function bindFullScreenEvents() {
    if (fullScreenEventsBound) return;
    const input = document.getElementById('nova-full-input');
    const send = document.getElementById('nova-full-send');
    if (send && input) {
      send.onclick = sendMessage;
      input.onkeypress = (e) => { if (e.key === 'Enter') sendMessage(); };
      fullScreenEventsBound = true;
    }
  }
  
  // Sekme değiştirme
  function setActiveTab(model) {
    currentModel = model;
    if (model === 'gemini') {
      tabGemini.style.background = '#1a2744';
      tabGemini.style.color = '#f0c040';
      tabGroq.style.background = '#0f1923';
      tabGroq.style.color = '#888';
      if (tabFullGemini) {
        tabFullGemini.style.background = '#1a2744';
        tabFullGemini.style.color = '#f0c040';
        tabFullGroq.style.background = '#0f1923';
        tabFullGroq.style.color = '#888';
      }
    } else {
      tabGroq.style.background = '#1a2744';
      tabGroq.style.color = '#f0c040';
      tabGemini.style.background = '#0f1923';
      tabGemini.style.color = '#888';
      if (tabFullGroq) {
        tabFullGroq.style.background = '#1a2744';
        tabFullGroq.style.color = '#f0c040';
        tabFullGemini.style.background = '#0f1923';
        tabFullGemini.style.color = '#888';
      }
    }
  }
  
  // Başlangıçta Groq aktif
  setActiveTab('groq');
  
  tabGemini.addEventListener('click', () => setActiveTab('gemini'));
  tabGroq.addEventListener('click', () => setActiveTab('groq'));
  if (tabFullGemini) tabFullGemini.addEventListener('click', () => setActiveTab('gemini'));
  if (tabFullGroq) tabFullGroq.addEventListener('click', () => setActiveTab('groq'));
  
  // Aktif mesaj container'ı
  function getActiveMessages() {
    return isMobile() && novaFull.style.display === 'flex' ? novaFullMessages : novaMessages;
  }
  
  // Mesaj ekleme
  function addMessage(text, isUser) {
    const container = getActiveMessages();
    const div = document.createElement('div');
    div.style.cssText = isUser 
      ? 'background:#2a3f5f;padding:12px;border-radius:8px;margin-left:20px;'
      : 'background:#1a2744;padding:12px;border-radius:8px;border-left:3px solid #f0c040;margin-right:20px;';
    div.innerHTML = `<p style="margin:0;font-size:0.8rem;color:#cdd9e5;line-height:1.5;white-space:pre-wrap;">${text}</p>`;
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
  }
  
  // Yükleniyor göstergesi
  function showLoading() {
    const container = getActiveMessages();
    const div = document.createElement('div');
    div.id = 'nova-loading';
    div.style.cssText = 'background:#1a2744;padding:12px;border-radius:8px;border-left:3px solid #f0c040;margin-right:20px;';
    div.innerHTML = '<p style="margin:0;font-size:0.8rem;color:#888;">NOVA düşünüyor...</p>';
    container.appendChild(div);
    container.scrollTop = container.scrollHeight;
  }
  
  function hideLoading() {
    const loading = document.getElementById('nova-loading');
    if (loading) loading.remove();
  }
  
  // Aktif input alanı
  function getActiveInput() {
    return isMobile() && novaFull.style.display === 'flex' ? novaFullInput : novaInput;
  }
  
  // Mesaj gönderme
  async function sendMessage() {
    const input = getActiveInput();
    const text = input.value.trim();
    if (!text) return;
    
    addMessage(text, true);
    input.value = '';
    showLoading();
    
    try {
      let response;
      if (currentModel === 'gemini') {
        response = await callGemini(text);
      } else {
        response = await callGroq(text);
      }
      hideLoading();
      addMessage(response, false);
    } catch (err) {
      hideLoading();
      addMessage(`Hata: ${err.message}. Lütfen tekrar deneyin.`, false);
    }
  }
  
  // ========== AYARLAR ve KULLANICI PROFILI ==========
  const novaSettingsBtn = document.getElementById('nova-settings-btn');
  const novaFullSettingsBtn = document.getElementById('nova-full-settings-btn');
  const novaSettingsPanel = document.getElementById('nova-settings-panel');
  const novaSettingsClose = document.getElementById('nova-settings-close');
  const novaSettingsSave = document.getElementById('nova-settings-save');
  // Input elementleri fonksiyonlar içinde document.getElementById ile seçilecek

  // Kullanıcı profili verilerini yükle
  function loadUserProfile() {
    const profile = JSON.parse(localStorage.getItem('nova_user_profile') || '{}');
    // Elementleri fonksiyon içinde seç
    const nameInput = document.getElementById('nova-user-name');
    const toneInput = document.getElementById('nova-user-tone');
    const styleInput = document.getElementById('nova-user-style');
    const bioInput = document.getElementById('nova-user-bio');
    const nicknameInput = document.getElementById('nova-user-nickname');
    
    if (nameInput) nameInput.value = profile.name || '';
    if (toneInput) toneInput.value = profile.tone || 'sen';
    if (styleInput) styleInput.value = profile.style || 'samimi';
    if (bioInput) bioInput.value = profile.bio || '';
    if (nicknameInput) nicknameInput.value = profile.nickname || '';
    return profile;
  }

  // Kullanıcı profili verilerini kaydet
  function saveUserProfile() {
    // Elementleri fonksiyon içinde seç
    const nameInput = document.getElementById('nova-user-name');
    const toneInput = document.getElementById('nova-user-tone');
    const styleInput = document.getElementById('nova-user-style');
    const bioInput = document.getElementById('nova-user-bio');
    const nicknameInput = document.getElementById('nova-user-nickname');
    
    const profile = {
      name: nameInput ? nameInput.value : '',
      tone: toneInput ? toneInput.value : 'sen',
      style: styleInput ? styleInput.value : 'samimi',
      bio: bioInput ? bioInput.value : '',
      nickname: nicknameInput ? nicknameInput.value : ''
    };
    localStorage.setItem('nova_user_profile', JSON.stringify(profile));
    return profile;
  }

  // Kullanıcı profili context'i oluştur
  function buildUserContext() {
    // Elementleri fonksiyon içinde seç - tanımlama sırası sorunu olmaması için
    const nameInput = document.getElementById('nova-user-name');
    const toneInput = document.getElementById('nova-user-tone');
    const styleInput = document.getElementById('nova-user-style');
    const bioInput = document.getElementById('nova-user-bio');
    const nicknameInput = document.getElementById('nova-user-nickname');
    
    const profile = {
      name: nameInput ? nameInput.value : '',
      tone: toneInput ? toneInput.value : 'sen',
      style: styleInput ? styleInput.value : 'samimi',
      bio: bioInput ? bioInput.value : '',
      nickname: nicknameInput ? nicknameInput.value : ''
    };
    
    let context = '';
    if (profile.name) {
      context += `Kullanıcının adı: ${profile.name}. `;
    }
    if (profile.nickname) {
      context += `Kullanıcıya "${profile.nickname}" diye hitap et. `;
    }
    if (profile.tone === 'sen') {
      context += 'Samimi bir dille "sen" diye hitap et. ';
    } else {
      context += 'Resmi bir dille "siz" diye hitap et. ';
    }
    const styleMap = {
      'samimi': 'Samimi ve sıcak bir ton kullan.',
      'profesyonel': 'Profesyonel ve ciddi bir ton kullan.',
      'esprili': 'Eğlenceli ve esprili bir ton kullan.',
      'sade': 'Sade ve net bir ton kullan.'
    };
    context += styleMap[profile.style] || styleMap['samimi'];
    if (profile.bio) {
      context += ` Kullanıcı hakkında: ${profile.bio}.`;
    }
    return context;
  }

  // Ayarlar panelini aç/kapa
  if (novaSettingsBtn) {
    novaSettingsBtn.addEventListener('click', () => {
      loadUserProfile();
      novaSettingsPanel.style.display = 'flex';
    });
  }
  if (novaFullSettingsBtn) {
    novaFullSettingsBtn.addEventListener('click', () => {
      loadUserProfile();
      novaSettingsPanel.style.display = 'flex';
    });
  }
  if (novaSettingsClose) {
    novaSettingsClose.addEventListener('click', () => {
      novaSettingsPanel.style.display = 'none';
    });
  }
  if (novaSettingsSave) {
    novaSettingsSave.addEventListener('click', () => {
      saveUserProfile();
      novaSettingsPanel.style.display = 'none';
      alert('Ayarlar kaydedildi!');
    });
  }

  // Context oluşturma - uygulama verileri
  function buildContext() {
    let context = '';
    
    // Kullanıcı analiz istediğinde verileri ekle
    const btcStatus = document.getElementById('btc-status');
    if (btcStatus && btcStatus.textContent) {
      context += `BTC: ${btcStatus.textContent}\n`;
    }
    
    // Aktif filtreler
    const activeTFs = getActiveTFs();
    if (activeTFs.length > 0) {
      context += `Aktif Filtreler: ${activeTFs.map(tf => tf.label).join(', ')}\n`;
    }
    
    // Sonuçlardaki coinler (ilk 10)
    if (scanResults && scanResults.length > 0) {
      context += `\nListedeki İlk Coinler:\n`;
      scanResults.slice(0, 10).forEach(coin => {
        const change = coin.change ? coin.change.toFixed(2) : '0';
        const fr = coinFRData[coin.symbol];
        const frVal = fr ? (fr.fundingRate * 100).toFixed(4) + '%' : 'N/A';
        context += `- ${coin.symbol}: %${change}, FR: ${frVal}\n`;
      });
    }
    
    // Alarm durumu
    if (alarms && alarms.length > 0) {
      const activeAlarms = alarms.filter(a => !a.triggered);
      context += `\nAktif Alarmlar: ${activeAlarms.length}\n`;
    }
    
    return context;
  }
  
  // Analiz anahtar kelimeleri kontrolü
  function isAnalysisRequest(message) {
    const analysisKeywords = [
      'analiz', 'analiz yap', 'yorumla', 'değerlendir', 'trend', 'sinyal',
      'btc', 'bitcoin', 'eth', 'ethereum', 'coin', 'fiyat', 'düşüş', 'yükseliş',
      'fr', 'oi', 'funding', 'open interest', 'bb', 'bollinger',
      'alarm', 'listede', 'göster', 'nasıl', 'durum', 'ne olur'
    ];
    const lowerMsg = message.toLowerCase();
    return analysisKeywords.some(keyword => lowerMsg.includes(keyword));
  }
  
  // Gemini API çağrısı
  async function callGemini(message) {
    try {
      const isAnalysis = isAnalysisRequest(message);
      const context = isAnalysis ? buildContext() : '';
      
      let prompt;
      if (isAnalysis && context) {
        prompt = `Sen NOVA adlı bir kripto para analiz asistanısın. Aşağıdaki Binance Filter uygulaması verilerine dayanarak analiz yap:\n\n${context}\n\nKullanıcı Sorusu: ${message}\n\nLütfen yukarıdaki verilere dayanarak detaylı kripto para analizi yap ve türkçe yanıt ver.`;
      } else {
        prompt = `Sen NOVA adlı yardımcı bir asistansın. Kullanıcıyla normal sohbet ediyorsun.\n\nKullanıcı: ${message}\n\nNOVA:`;
      }
      
      const response = await fetch('/api/gemini', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          contents: [{ parts: [{ text: prompt }] }],
          generationConfig: { maxOutputTokens: 800, temperature: 0.7 }
        })
      });
      
      if (!response.ok) {
        const errData = await response.json();
        console.error('Gemini HTTP hatası:', response.status, errData);
        throw new Error(`HTTP ${response.status}: ${errData.error?.message || 'Bilinmeyen hata'}`);
      }
      
      const data = await response.json();
      console.log('Gemini yanıtı:', data);
      
      if (data.candidates && data.candidates[0] && data.candidates[0].content) {
        return data.candidates[0].content.parts[0].text;
      }
      if (data.error) {
        throw new Error(data.error.message || 'Gemini API hatası');
      }
      throw new Error('Gemini yanıt vermedi');
    } catch (err) {
      console.error('Gemini çağrı hatası:', err);
      throw err;
    }
  }
  
  // Groq API çağrısı
  async function callGroq(message) {
    try {
      const isAnalysis = isAnalysisRequest(message);
      const appContext = isAnalysis ? buildContext() : '';
      const userContext = buildUserContext();
      
      let systemPrompt, userPrompt;
      if (isAnalysis && appContext) {
        systemPrompt = `Sen NOVA adlı bir kripto para analiz asistanısın. ${userContext}`;
        userPrompt = `Aşağıdaki verilere dayanarak analiz yap:\n\n${appContext}\n\nKullanıcı Sorusu: ${message}`;
      } else {
        systemPrompt = `Sen NOVA adlı yardımcı bir asistansın. ${userContext}`;
        userPrompt = message;
      }
      
      const response = await fetch('/api/groq', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          model: 'llama-3.1-8b-instant',
          messages: [
            { role: 'system', content: systemPrompt },
            { role: 'user', content: userPrompt }
          ],
          max_tokens: 800,
          temperature: 0.7
        })
      });
      
      if (!response.ok) {
        const errData = await response.json();
        console.error('Groq HTTP hatası:', response.status, errData);
        throw new Error(`HTTP ${response.status}: ${errData.error?.message || 'Bilinmeyen hata'}`);
      }
      
      const data = await response.json();
      console.log('Groq yanıtı:', data);
      
      if (data.choices && data.choices[0] && data.choices[0].message) {
        return data.choices[0].message.content;
      }
      if (data.error) {
        throw new Error(data.error.message || 'Groq API hatası');
      }
      throw new Error('Groq yanıt vermedi');
    } catch (err) {
      console.error('Groq çağrı hatası:', err);
      throw err;
    }
  }
  
  // Mesaj gönderme
  async function sendMessage() {
    const input = getActiveInput();
    const text = input.value.trim();
    if (!text) return;
    
    addMessage(text, true);
    input.value = '';
    showLoading();
    
    try {
      let response;
      if (currentModel === 'gemini') {
        response = await callGemini(text);
      } else {
        response = await callGroq(text);
      }
      hideLoading();
      addMessage(response, false);
    } catch (err) {
      hideLoading();
      addMessage(`Hata: ${err.message}. Lütfen tekrar deneyin.`, false);
    }
  }
})();
</script>
</body>
</html>
